#!/usr/bin/env python3
"""Build MIDTERM SIGNALS PROD v1.0.

The official numerical forecast preserves the v0.2 prospective model specification:
structural partisan baseline + weighted generic ballot + incumbency + qualifying
race polls, followed by correlated Monte Carlo chamber simulations. v1.0 expands
publication, provenance, distributions, history, source-health and exploration
artifacts without retuning the model to resemble external forecasters.
"""
from __future__ import annotations

import csv
import hashlib
import html
import io
import json
import math
import random
import shutil
import statistics
import urllib.request
from collections import Counter, defaultdict
from datetime import date, datetime, timezone
from pathlib import Path
from urllib.parse import quote

ROOT = Path(__file__).resolve().parents[1]
PUBLIC = ROOT / "public"
DATA = PUBLIC / "data"
OUT = DATA / "forecast.json"
STATUS = DATA / "status.json"
SOURCE_STATUS = DATA / "source-status.json"
SEARCH = DATA / "search.json"
SIGNALS = DATA / "signals.json"
RESULTS = DATA / "results.json"
RUN_REPORT = DATA / "run-report.json"
HIST = DATA / "history"
UPSTREAM_REPO = "ElectIndex/26_us_forecast_data"
API_COMMIT = f"https://api.github.com/repos/{UPSTREAM_REPO}/commits/main"
RAW = "https://raw.githubusercontent.com/{repo}/{sha}/{name}"
USER_AGENT = "MIDTERM-SIGNALS/1.0 (+https://github.com/MusicOfScience/midterm-signals)"
ELECTION_DATE = date(2026, 11, 3)
NAT_PRES = {2016: 2.09, 2020: 4.46, 2024: -1.47}
CURRENT_SENATE = {"DEM": 47, "REP": 53}
MODEL_NAME = "MIDTERM SIGNALS baseline-v1.0"
SCHEMA_VERSION = "1.0.0"
SIMULATIONS = 30_000  # unchanged from prospective v0.2 baseline


def fetch(url: str) -> bytes:
    req = urllib.request.Request(url, headers={"User-Agent": USER_AGENT})
    with urllib.request.urlopen(req, timeout=45) as r:
        return r.read()


def csv_rows(data: bytes) -> list[dict[str, str]]:
    return list(csv.DictReader(io.StringIO(data.decode("utf-8-sig"))))


def f(row: dict[str, str], key: str, default: float = 0.0) -> float:
    try:
        value = row.get(key, "")
        return float(value) if value not in (None, "") else default
    except (TypeError, ValueError):
        return default


def parse_day(value: str | None) -> date | None:
    try:
        return date.fromisoformat(value or "")
    except Exception:
        return None


def normal_cdf(z: float) -> float:
    return 0.5 * (1.0 + math.erf(z / math.sqrt(2.0)))


def clamp(x: float, lo: float, hi: float) -> float:
    return max(lo, min(hi, x))


def surname(name: str) -> str:
    if not name or name.startswith("("):
        return ""
    bits = [b.strip(".,'") for b in name.lower().replace("-", " ").split()]
    return bits[-1] if bits else ""


def candidate_match(poll_name: str, race_name: str) -> bool:
    if not poll_name or not race_name:
        return False
    if "generic" in poll_name.lower():
        return True
    s = surname(race_name)
    return bool(s and s in poll_name.lower())


def poll_weight(row: dict[str, str], latest: date, half_life: float) -> float:
    d = parse_day(row.get("end_date"))
    if not d:
        return 0.0
    age = max(0, (latest - d).days)
    quality = clamp(f(row, "rating", 1.3), 0.75, 3.0)
    n = max(250.0, f(row, "n", 800.0))
    sponsor = row.get("lean", "").strip().upper()
    sponsor_mult = 0.68 if sponsor in {"D", "R"} else 1.0
    return math.exp(-math.log(2) * age / half_life) * (quality / 1.5) ** 1.15 * math.sqrt(n / 1000.0) * sponsor_mult


def clean_poll(row: dict[str, str], weight: float | None = None, kind: str = "generic_ballot") -> dict:
    margin = f(row, "margin", f(row, "dem") - f(row, "rep"))
    result = {
        "kind": kind,
        "race_code": row.get("race_code") or None,
        "pollster": row.get("pollster") or "Unknown pollster",
        "sponsor": row.get("sponsor") or None,
        "sponsor_lean": row.get("lean") or None,
        "start_date": row.get("start_date") or None,
        "end_date": row.get("end_date") or None,
        "publication_date": row.get("publication_date") or row.get("publish_date") or None,
        "n": int(f(row, "n", 0)) or None,
        "population": row.get("population") or row.get("sample_type") or None,
        "mode": row.get("mode") or None,
        "dem": round(f(row, "dem"), 1),
        "rep": round(f(row, "rep"), 1),
        "margin": round(margin, 1),
        "source": row.get("source") or row.get("url") or None,
        "question": row.get("question") or None,
        "quality_input": round(f(row, "rating", 0), 2) or None,
    }
    if weight is not None:
        result["model_weight"] = round(weight, 5)
    return result


def aggregate_gcb(rows: list[dict[str, str]], asof: date) -> tuple[float, list[dict], int, date]:
    usable = []
    for r in rows:
        d = parse_day(r.get("end_date"))
        if d and d <= asof and (asof - d).days <= 35:
            usable.append(r)
    if not usable:
        raise RuntimeError("No recent generic-ballot polls")
    latest = max(parse_day(r["end_date"]) for r in usable if parse_day(r["end_date"]))
    num = den = 0.0
    shown = []
    for r in usable:
        w = poll_weight(r, latest, 11.0)
        num += w * (f(r, "dem") - f(r, "rep"))
        den += w
        shown.append(clean_poll(r, w, "generic_ballot"))
    if den <= 0:
        raise RuntimeError("Generic-ballot weights sum to zero")
    shown.sort(key=lambda x: x.get("end_date") or "", reverse=True)
    return num / den, shown, len(usable), latest


def qualifying_race_polls(rows: list[dict[str, str]], race: dict[str, str], asof: date) -> list[dict[str, str]]:
    chosen = []
    for r in rows:
        if r.get("race_code") != race["race_code"]:
            continue
        d = parse_day(r.get("end_date"))
        if not d or d > asof or (asof - d).days > 55:
            continue
        if race.get("dem_name") and not candidate_match(r.get("dem_name", ""), race.get("dem_name", "")):
            continue
        if race.get("rep_name") and not candidate_match(r.get("rep_name", ""), race.get("rep_name", "")):
            continue
        chosen.append(r)
    return chosen


def race_poll_average(rows: list[dict[str, str]], race: dict[str, str], asof: date) -> tuple[float | None, float, int, str | None, list[dict]]:
    chosen = qualifying_race_polls(rows, race, asof)
    if not chosen:
        return None, 0.0, 0, None, []
    latest = max(parse_day(r["end_date"]) for r in chosen if parse_day(r["end_date"]))
    num = den = 0.0
    cleaned = []
    for r in chosen:
        w = poll_weight(r, latest, 13.0)
        num += w * f(r, "margin", f(r, "dem") - f(r, "rep"))
        den += w
        cleaned.append(clean_poll(r, w, "race"))
    if den <= 0:
        return None, 0.0, 0, None, []
    avg = num / den
    blend = clamp(0.27 * math.sqrt(len(chosen)), 0.20, 0.86)
    freshness = math.exp(-max(0, (asof - latest).days) / 28.0)
    blend *= 0.75 + 0.25 * freshness
    cleaned.sort(key=lambda x: x.get("end_date") or "", reverse=True)
    return avg, blend, len(chosen), latest.isoformat(), cleaned


def rating(p: float) -> str:
    q = max(p, 1 - p)
    side = "D" if p >= 0.5 else "R"
    if q < 0.55:
        return "Toss-up"
    if q < 0.70:
        return f"Lean {side}"
    if q < 0.90:
        return f"Likely {side}"
    return f"Safe {side}"


def relative_lean(h: dict[str, str]) -> float:
    m16 = f(h, "margin_2016") - NAT_PRES[2016]
    m20 = f(h, "margin_2020") - NAT_PRES[2020]
    m24 = f(h, "margin_2024") - NAT_PRES[2024]
    return 0.05 * m16 + 0.20 * m20 + 0.75 * m24


def race_model(race: dict[str, str], hist: dict[str, dict[str, str]], poll_rows: list[dict[str, str]], gcb: float, asof: date) -> dict:
    code = race["race_code"]
    h = hist.get(code) or hist.get(race.get("state", ""))
    if not h:
        raise RuntimeError(f"No historical baseline for {code}")
    lean = relative_lean(h)
    inc = race.get("incumbent_party", "").upper()
    inc_adj = 1.0 if inc == "DEM" else -1.0 if inc == "REP" else 0.0
    if race.get("race_type") == "senate":
        inc_adj *= 1.15
    prior = lean + gcb + inc_adj
    poll_margin, pweight, pcount, plast, polls = race_poll_average(poll_rows, race, asof)
    margin = prior if poll_margin is None else (1 - pweight) * prior + pweight * poll_margin
    dem_name = race.get("dem_name", "")
    rep_name = race.get("rep_name", "")
    ind_name = race.get("ind_name", "")
    ind_caucus = race.get("ind_caucus", "").upper()
    aligned_ind = bool(ind_name and ind_caucus == "DEM" and (not dem_name or dem_name.startswith("(No Democrat)")))
    dem_display = ind_name if aligned_ind else dem_name
    same_party = race.get("same_party", "").upper()
    base_sigma = 6.3 if race.get("race_type") == "house" else 7.2
    sigma = max(3.1, base_sigma * (1 - 0.42 * pweight))
    if same_party == "DEM":
        p_dem, margin = 0.999, 50.0
    elif same_party == "REP":
        p_dem, margin = 0.001, -50.0
    elif (not dem_name or dem_name.startswith("(No Democrat)")) and not aligned_ind:
        p_dem, margin = 0.001, min(margin, -35.0)
    elif not rep_name or rep_name.startswith("(No Republican)"):
        p_dem, margin = 0.999, max(margin, 35.0)
    else:
        p_dem = clamp(normal_cdf(margin / sigma), 0.001, 0.999)
    dshare = clamp(50 + margin / 2, 1.0, 99.0)
    return {
        "race_code": code,
        "race_type": race["race_type"],
        "state": race.get("state"),
        "district": race.get("district"),
        "dem_candidate": dem_display or None,
        "rep_candidate": rep_name or None,
        "incumbent_party": inc or None,
        "seat_holder": race.get("seat_holder") or None,
        "open_seat": not bool(inc),
        "dem_probability": round(p_dem, 4),
        "rep_probability": round(1 - p_dem, 4),
        "forecast_margin_d_minus_r": round(margin, 2),
        "dem_two_party_vote": round(dshare, 1),
        "rep_two_party_vote": round(100 - dshare, 1),
        "rating": rating(p_dem),
        "relative_partisan_lean_d_minus_r": round(lean, 2),
        "prior_margin": round(prior, 2),
        "model_sigma": round(sigma, 3),
        "poll_average_margin": round(poll_margin, 2) if poll_margin is not None else None,
        "poll_weight": round(pweight, 3),
        "poll_count": pcount,
        "latest_race_poll": plast,
        "polls": polls,
        "presidential_margin_2024": round(f(h, "margin_2024"), 2),
        "aligned_independent": aligned_ind,
        "rcv": race.get("rcv", "").lower() == "true",
        "three_way": race.get("threeway", "").lower() == "true",
        "same_party": same_party or None,
        "external_forecasters": {},
        "money": None,
    }


def quantile(vals: list[int], q: float) -> int:
    vals = sorted(vals)
    return vals[int(round((len(vals) - 1) * q))] if vals else 0


def summarize_counts(vals: list[int], total: int, threshold: int, held_dem: int | None = None) -> dict:
    mean = statistics.fmean(vals)
    counts = Counter(vals)
    mode = min((-count, seats) for seats, count in counts.items())[1]
    interval = lambda p: [quantile(vals, (1 - p) / 2), quantile(vals, 1 - (1 - p) / 2)]
    out = {
        "dem_control_probability": round(sum(v >= threshold for v in vals) / len(vals), 4),
        "expected_dem_seats": round(mean, 1),
        "expected_rep_seats": round(total - mean, 1),
        "median_dem_seats": quantile(vals, 0.5),
        "modal_dem_seats": mode,
        "dem_seats_50_interval": interval(0.50),
