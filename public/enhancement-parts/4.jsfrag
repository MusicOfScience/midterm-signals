/* ------------------------------ HISTORY ------------------------------- */
function compactDelta(a,b,key){const x=a?.[key],y=b?.[key];return Number.isFinite(x)&&Number.isFinite(y)?x-y:null}
function historyPreview(row,current){if(!row)return'<div class="empty-state">No snapshot selected.</div>';const dh=compactDelta(row,current,'house'),ds=compactDelta(row,current,'senate'),dhs=compactDelta(row,current,'house_seats'),dg=compactDelta(row,current,'generic_ballot_d_minus_r');return `<div class="history-preview"><div><small>Snapshot</small><strong>${esc(new Date(row.generated_at).toLocaleString())}</strong></div><div><small>House D control</small><strong>${pct(row.house)}</strong><span>${Number.isFinite(dh)?`${pp(dh)} vs selected baseline`:''}</span></div><div><small>Senate D control</small><strong>${pct(row.senate)}</strong><span>${Number.isFinite(ds)?`${pp(ds)} vs selected baseline`:''}</span></div><div><small>Expected D House seats</small><strong>${fmt(row.house_seats)}</strong><span>${Number.isFinite(dhs)?`${dhs>0?'+':''}${dhs.toFixed(1)} seats`:''}</span></div><div><small>Generic ballot</small><strong>${signed(row.generic_ballot_d_minus_r)}</strong><span>${Number.isFinite(dg)?`${dg>0?'+':''}${dg.toFixed(1)} pts`:''}</span></div></div>`}
async function enhanceHistory(){
  const list=q('.history-list');if(!list||q('#historyWorkbench'))return;const idx=await historyIndex(),rows=(idx.summaries||[]).length?idx.summaries:((await model()).history_summaries||[]);if(!rows.length)return;
  const panel=list.closest('.panel'),work=document.createElement('section');work.id='historyWorkbench';work.className='history-workbench';const latest=rows[0];work.innerHTML=`<div class="history-controls"><label>Snapshot scrubber <input id="historySlider" type="range" min="0" max="${Math.max(0,rows.length-1)}" value="0" step="1"></label><button type="button" id="historyPlay" class="button secondary">Play</button><label>Compare with <select id="historyCompare"><option value="1">previous snapshot</option><option value="7">about 7 days earlier</option><option value="30">about 30 days earlier</option><option value="first">first indexed forecast</option></select></label><button type="button" id="historyOpen" class="button secondary">Open selected full snapshot</button></div><div id="historyPreview">${historyPreview(latest,latest)}</div><div id="historyCompareOut"></div>`;panel?.prepend(work);
  const slider=q('#historySlider'),preview=q('#historyPreview'),compareOut=q('#historyCompareOut');let timer=null;
  const selected=()=>rows[Math.min(rows.length-1,Number(slider.value)||0)];
  const nearestDays=(anchor,days)=>{const target=new Date(anchor.generated_at).valueOf()-days*86400000;return rows.reduce((best,x)=>Math.abs(new Date(x.generated_at).valueOf()-target)<Math.abs(new Date(best.generated_at).valueOf()-target)?x:best,rows.at(-1))};
  const render=()=>{const a=selected();preview.innerHTML=historyPreview(a,a);const v=q('#historyCompare').value;let b=v==='first'?rows.at(-1):nearestDays(a,Number(v));compareOut.innerHTML=`<div class="eyebrow">COMPARISON</div>${historyPreview(a,b)}<p class="data-note">Differences are arithmetic comparisons of archived outputs. Causation is shown only where the snapshot’s changed-input metadata identifies changed inputs.</p>`};
  slider.addEventListener('input',render);q('#historyCompare').addEventListener('change',render);q('#historyPlay').addEventListener('click',()=>{if(timer){clearInterval(timer);timer=null;q('#historyPlay').textContent='Play';return}if(matchMedia('(prefers-reduced-motion: reduce)').matches)return;slider.value=String(rows.length-1);render();q('#historyPlay').textContent='Pause';timer=setInterval(()=>{const n=Number(slider.value)-1;if(n<0){clearInterval(timer);timer=null;q('#historyPlay').textContent='Play';return}slider.value=String(n);render()},850)});
  q('#historyOpen').addEventListener('click',()=>openSnapshot(selected()?.file));
  list.addEventListener('click',e=>{const b=e.target.closest('[data-history-file]');if(b)openSnapshot(b.dataset.historyFile,b)});render();
}
async function openSnapshot(file,button=null){if(!file)return;button?.setAttribute('aria-busy','true');try{const snap=await fetch(`/data/history/${encodeURIComponent(file)}`,{cache:'no-store'}).then(r=>{if(!r.ok)throw new Error(r.status);return r.json()});let detail=q('#snapshotDetail');if(!detail){detail=document.createElement('section');detail.id='snapshotDetail';detail.className='section panel panel-pad';q('.history-list')?.closest('.panel')?.after(detail)}const h=snap.summary?.house||{},s=snap.summary?.senate||{},g=snap.national_environment?.generic_ballot_d_minus_r;const close=(snap.races||[]).slice().sort((a,b)=>uncertainty(a)-uncertainty(b)).slice(0,8);detail.innerHTML=`<div class="eyebrow">SELECTED IMMUTABLE SNAPSHOT</div><h2>${esc(new Date(snap.generated_at).toLocaleString())}</h2><div class="facts-grid"><div class="fact"><b>${pct(h.dem_control_probability)}</b><span>House D control</span></div><div class="fact"><b>${fmt(h.expected_dem_seats)}</b><span>expected D House seats</span></div><div class="fact"><b>${pct(s.dem_control_probability)}</b><span>Senate D control</span></div><div class="fact"><b>${Number.isFinite(g)?signed(g):'—'}</b><span>generic ballot D−R</span></div></div><h3>Closest races then</h3><div class="race-grid">${close.map(r=>`<button class="race-tile ${winner(r)==='D'?'d-edge':'r-edge'}" type="button" data-v1-race="${esc(r.race_code)}"><span class="symbol">${esc(r.race_code)}</span><small>${pct(winp(r))} ${winner(r)}</small></button>`).join('')}</div><p class="data-note">Full immutable archived snapshot. It is not recomputed with today’s inputs or model state.</p>`;detail.onclick=e=>{const b=e.target.closest('[data-v1-race]');if(b)navigateRace(b.dataset.v1Race)};detail.scrollIntoView({block:'start'})}catch(err){console.error('snapshot',err)}finally{button?.removeAttribute('aria-busy')}}
async function enhanceRaceHistory(){
  const panels=qa('.section.panel'),panel=panels.find(x=>x.querySelector('.eyebrow')?.textContent.trim()==='PROBABILITY HISTORY');if(!panel||panel.dataset.compactHistory)return;panel.dataset.compactHistory='true';const code=new URLSearchParams(location.search).get('race')||decodeURIComponent(location.pathname.split('/').filter(Boolean)[1]||'');if(!code)return;const series=await raceSeries(),pts=series?.races?.[code]||series?.races?.[code.toUpperCase()]||[];if(!pts.length)return;const body=panel.querySelector('.empty-state,.timeline-list');if(body)body.outerHTML=`<div class="timeline-list">${pts.slice(-60).map(x=>`<div class="timeline"><small>${esc(new Date(x.generated_at).toLocaleDateString())}</small><div class="track" role="img" aria-label="Democratic win probability ${pct(x.dem_probability)}"><span style="width:${Math.max(0,Math.min(100,(x.dem_probability??.5)*100))}%"></span></div><strong>${pct(x.dem_probability)}</strong></div>`).join('')}</div><p class="data-note">Compact derivative timeline from immutable production snapshots. Full snapshots remain the source of truth.</p>`;
}

