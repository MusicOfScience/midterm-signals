/* -------------------------- RACE EXPLORER ----------------------------- */
function explorerExternal(r){const ext=externalEntries(r);if(!ext.length)return'—';return ext.map(([name,x])=>`${name.replace('Political Report','').replace('Decision Desk HQ','DDHQ')}: ${x.rating??pct(x.probability)}`).join(' · ')}
function explorerRow(r){const delta=r.change?.dem_probability??0,last=r.latest_race_poll||'—',poll=r.poll_average_margin==null?'—':signed(r.poll_average_margin),base=Number.isFinite(r.relative_partisan_lean_d_minus_r)?signed(r.relative_partisan_lean_d_minus_r):'—',disc=disagreement(r);return `<div class="explorer-row" data-race-code="${esc(r.race_code)}"><div data-label="Race"><button type="button" class="text-link" data-v1-race="${esc(r.race_code)}"><strong>${esc(r.race_code)}</strong></button><small>${esc(stateLabel(r.state))}${r.open_seat?' · open':' '}</small></div><div data-label="Democrat">${esc(r.dem_candidate||'—')}</div><div data-label="Republican">${esc(r.rep_candidate||'—')}</div><div data-label="Model"><strong class="${winner(r)==='D'?'lead-d':'lead-r'}">${pct(winp(r))} ${winner(r)}</strong><small>${pct(r.dem_probability)} D</small></div><div data-label="Expected margin">${esc(signed(r.forecast_margin_d_minus_r))}</div><div data-label="Poll average">${esc(poll)}</div><div data-label="Baseline">${esc(base)}</div><div data-label="Rating">${esc(r.rating||'—')}</div><div data-label="Movement"><span class="movement ${delta>0?'lead-d':delta<0?'lead-r':''}">${Math.abs(delta)<.00005?'—':pp(delta)}</span></div><div data-label="Last poll">${esc(last)}</div><div data-label="External"><span class="${disc==='major'?'disagree-major':''}">${esc(explorerExternal(r))}</span></div></div>`}
function sortExplorer(rows,sort){const r=[...rows];if(sort==='dprob')return r.sort((a,b)=>(b.dem_probability??0)-(a.dem_probability??0));if(sort==='rprob')return r.sort((a,b)=>(a.dem_probability??0)-(b.dem_probability??0));if(sort==='movement')return r.sort((a,b)=>Math.abs(b.change?.dem_probability||0)-Math.abs(a.change?.dem_probability||0));if(sort==='margin')return r.sort((a,b)=>Math.abs(a.forecast_margin_d_minus_r||0)-Math.abs(b.forecast_margin_d_minus_r||0));if(sort==='polls')return r.sort((a,b)=>(b.poll_count||0)-(a.poll_count||0));if(sort==='baseline')return r.sort((a,b)=>Math.abs(a.relative_partisan_lean_d_minus_r||0)-Math.abs(b.relative_partisan_lean_d_minus_r||0));return r.sort((a,b)=>uncertainty(a)-uncertainty(b))}
async function enhanceExplorer(){
  const results=q('#raceResults'),toolbar=q('#moreFilters');if(!results||!toolbar||q('#explorerV1'))return;
  const data=await model(),p=new URLSearchParams(location.search),extConfigured=(data.external_forecasters?.configured_count||0)>0,moneyConfigured=data.money?.state==='current';
  const extras=document.createElement('section');extras.id='explorerV1';extras.className='explorer-tools';extras.innerHTML=`<div class="preset-row explorer-presets" aria-label="Race Explorer presets"><button type="button" data-v1-preset="tossup">TOSS-UPS</button><button type="button" data-v1-preset="flip">MOST LIKELY FLIPS</button><button type="button" data-v1-preset="uncertain">MOST UNCERTAIN</button><button type="button" data-v1-preset="movers">BIGGEST MOVERS</button><button type="button" data-v1-preset="unpolled">UNPOLLED BATTLEGROUNDS</button><button type="button" data-v1-preset="disagreement" ${extConfigured?'':'disabled title="No licensed external-forecaster feed configured"'}>MODEL / EXPERT DISAGREEMENT</button></div><div class="toolbar explorer-extra"><select id="raceIncumbency" aria-label="Incumbency"><option value="all">Incumbent + open</option><option value="open">Open seats only</option><option value="incumbent">Incumbent seats only</option></select><select id="raceMovement" aria-label="Forecast movement"><option value="all">Any movement</option><option value="big">Moved ≥5 pp</option><option value="d">Moved toward D</option><option value="r">Moved toward R</option></select><select id="raceSeatMode" aria-label="Seat status"><option value="all">Any seat status</option><option value="flip">Model-favoured flips</option></select><select id="raceSort" aria-label="Sort races"><option value="competitive">Sort: closest first</option><option value="movement">Sort: biggest movers</option><option value="dprob">Sort: D probability</option><option value="rprob">Sort: R probability</option><option value="margin">Sort: closest margin</option><option value="polls">Sort: most polls</option><option value="baseline">Sort: closest baseline</option></select><select id="raceExternal" aria-label="External forecaster disagreement" ${extConfigured?'':'disabled'}><option value="all">${extConfigured?'Any expert status':'External ratings unavailable'}</option><option value="major">Major disagreement</option><option value="mild">Any disagreement</option></select><select id="raceMoney" aria-label="Fundraising filter" disabled><option>${moneyConfigured?'Money filter pending comparable periods':'FEC data unavailable'}</option></select></div><p class="data-note">External-rating and money filters activate only when permitted, comparable source data are present. Disabled controls are deliberate unavailable states, not missing UI.</p>`;
  toolbar.after(extras);
  for(const [id,key] of [['raceIncumbency','incumbency'],['raceMovement','movement'],['raceSeatMode','seatmode'],['raceSort','sort'],['raceExternal','external']]){const el=q(`#${id}`);if(el&&p.get(key))el.value=p.get(key)}
  const render=()=>{
    const f={query:q('#raceQ')?.value||'',chamber:q('#raceChamber')?.value||'all',state:q('#raceState')?.value||'all',party:q('#raceParty')?.value||'all',competitiveness:q('#raceComp')?.value||'all',polling:q('#racePolling')?.value||'all',minProb:Number(q('#minProb')?.value||0)/100,maxProb:Number(q('#maxProb')?.value||100)/100};
    let rows=filterRaces(data.races||[],f);const inc=q('#raceIncumbency').value,mv=q('#raceMovement').value,seat=q('#raceSeatMode').value,external=q('#raceExternal').value;
    rows=rows.filter(r=>{const d=r.change?.dem_probability||0;if(inc==='open'&&!r.open_seat)return false;if(inc==='incumbent'&&r.open_seat)return false;if(mv==='big'&&Math.abs(d)<.05)return false;if(mv==='d'&&d<=0)return false;if(mv==='r'&&d>=0)return false;if(seat==='flip'&&!((r.seat_holder==='REP'&&r.dem_probability>.5)||(r.seat_holder==='DEM'&&r.dem_probability<.5)))return false;const disc=disagreement(r);if(external==='major'&&disc!=='major')return false;if(external==='mild'&&!['major','mild'].includes(disc))return false;return true});
    rows=sortExplorer(rows,q('#raceSort').value);
    results.innerHTML=`<div class="explorer-table"><div class="explorer-row explorer-head" aria-hidden="true"><div>RACE</div><div>DEMOCRAT</div><div>REPUBLICAN</div><div>MODEL</div><div>MARGIN</div><div>POLL AVG</div><div>BASELINE</div><div>RATING</div><div>MOVEMENT</div><div>LAST POLL</div><div>EXTERNAL</div></div>${rows.map(explorerRow).join('')}</div>`;
    const summary=q('#filterSummary');if(summary)summary.textContent=`${rows.length} of ${data.races.length} races shown · sorted ${q('#raceSort').selectedOptions[0].textContent.replace('Sort: ','').toLowerCase()}.`;
    const u=new URL(location.href);u.searchParams.set('view','races');for(const [key,val,def] of [['incumbency',inc,'all'],['movement',mv,'all'],['seatmode',seat,'all'],['sort',q('#raceSort').value,'competitive'],['external',external,'all']]){if(val!==def)u.searchParams.set(key,val);else u.searchParams.delete(key)}history.replaceState(null,'',u);
  };
  const controls=[...qa('#raceToolbar input,#raceToolbar select,#moreFilters input,#moreFilters select,#explorerV1 select')];controls.forEach(el=>el.addEventListener(el.tagName==='INPUT'?'input':'change',()=>queueMicrotask(render)));
  extras.addEventListener('click',e=>{const b=e.target.closest('[data-v1-preset]');if(!b)return;const preset=b.dataset.v1Preset;if(preset==='tossup')q('#raceComp').value='tossup';if(preset==='uncertain')q('#raceComp').value='uncertain';if(preset==='flip')q('#raceSeatMode').value='flip';if(preset==='movers'){q('#raceMovement').value='big';q('#raceSort').value='movement'}if(preset==='unpolled'){q('#raceComp').value='competitive';q('#racePolling').value='none'}if(preset==='disagreement'&&extConfigured)q('#raceExternal').value='mild';render()});
  results.addEventListener('click',e=>{const b=e.target.closest('[data-v1-race]');if(b)navigateRace(b.dataset.v1Race)});
  render();
}

