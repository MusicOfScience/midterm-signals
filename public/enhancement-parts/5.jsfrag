/* -------------------------- SCENARIO LAB ------------------------------ */
function scenarioAdvancedMarkup(result,base,meta){const h=result.house,s=result.senate;return `<div class="scenario-banner">SCENARIO, NOT OFFICIAL FORECAST · official baseline remains unchanged</div><section class="chamber-pair"><article class="chamber-card"><div class="eyebrow">HOUSE SCENARIO</div><h2>${pct(h.dem_control_probability)} Democratic control</h2><div class="facts-grid"><div class="fact"><b>${fmt(h.expected_dem_seats)}</b><span>expected D seats</span></div><div class="fact"><b>${(h.dem_seats_80_interval||[]).join('–')}</b><span>80% interval</span></div><div class="fact"><b>${pp(h.dem_control_probability-base.house.dem_control_probability)}</b><span>vs official control probability</span></div><div class="fact"><b>${fmt(h.expected_dem_seats-base.house.expected_dem_seats)}</b><span>D-seat change</span></div></div></article><article class="chamber-card"><div class="eyebrow">SENATE SCENARIO</div><h2>${pct(s.dem_control_probability)} Democratic control</h2><div class="facts-grid"><div class="fact"><b>${fmt(s.expected_dem_seats)}</b><span>expected D seats</span></div><div class="fact"><b>${(s.dem_seats_80_interval||[]).join('–')}</b><span>80% interval</span></div><div class="fact"><b>${pp(s.dem_control_probability-base.senate.dem_control_probability)}</b><span>vs official control probability</span></div><div class="fact"><b>${fmt(s.expected_dem_seats-base.senate.expected_dem_seats)}</b><span>D-seat change</span></div></div></article></section><p class="data-note">${esc(meta)}</p>`}
async function enhanceScenario(){
  if(routeView()!=='scenarios'||q('#scenarioAdvanced'))return;const data=await model(),controls=q('.scenario-controls');if(!controls)return;const p=new URLSearchParams(location.search),turnout=Number(p.get('turnout')||0),overrideRace=p.get('overrideRace')||'',overrideChoice=p.get('overrideChoice')||'';const senate=(data.races||[]).filter(r=>r.race_type==='senate'&&r.dem_probability>.08&&r.dem_probability<.92).sort((a,b)=>uncertainty(a)-uncertainty(b));
  const box=document.createElement('section');box.id='scenarioAdvanced';box.className='scenario-advanced';box.innerHTML=`<div class="scenario-control"><label for="scTurnout">Turnout environment, D−R margin shock</label><input id="scTurnout" type="number" min="-8" max="8" step="0.5" value="${turnout}"><small>Exploratory uniform margin shock, not a turnout-estimation model.</small></div><div class="scenario-control"><label for="scOverrideRace">Specific Senate race override</label><select id="scOverrideRace"><option value="">No override</option>${senate.map(r=>`<option value="${esc(r.race_code)}">${esc(r.race_code)} · ${esc(r.dem_candidate||'D')} vs ${esc(r.rep_candidate||'R')}</option>`).join('')}</select></div><div class="scenario-control"><label for="scOverrideChoice">Override winner</label><select id="scOverrideChoice"><option value="">Use model</option><option value="D">Democratic / aligned win</option><option value="R">Republican win</option></select></div>`;controls.after(box);q('#scOverrideRace').value=overrideRace;q('#scOverrideChoice').value=overrideChoice;
  const render=()=>{const g=Number(q('#scG')?.value||0),h=Number(q('#scH')?.value||0),s=Number(q('#scS')?.value||0),t=Number(q('#scTurnout').value||0),race=q('#scOverrideRace').value,choice=q('#scOverrideChoice').value,overrides={};if(race&&choice)overrides[race]=choice;const advanced=t!==0||(race&&choice);if(advanced){const result=runScenario(data,{genericBallotShift:g,houseSwing:h+t,senateSwing:s+t,overrides},6000);q('#scenarioOutput').innerHTML=scenarioAdvancedMarkup(result,data.summary,`Turnout environment applies a ${t>=0?'D':'R'} ${Math.abs(t).toFixed(1)}-point uniform margin shock to both chambers${race&&choice?`; ${race} is fixed to ${choice}`:''}. This is a counterfactual stress test, not an official forecast.`)}const u=new URL(location.href);if(t)u.searchParams.set('turnout',t);else u.searchParams.delete('turnout');if(race&&choice){u.searchParams.set('overrideRace',race);u.searchParams.set('overrideChoice',choice)}else{u.searchParams.delete('overrideRace');u.searchParams.delete('overrideChoice')}history.replaceState(null,'',u)};
  qa('#scG,#scH,#scS,#scenarioAdvanced input,#scenarioAdvanced select').forEach(x=>x?.addEventListener('input',()=>queueMicrotask(render)));qa('#scenarioAdvanced select').forEach(x=>x.addEventListener('change',render));render();
}

/* ----------------------- FORECASTER COMPARISON ------------------------ */
async function enhanceForecasters(){
  if(routeView()!=='forecast'||q('#forecasterWorkbench'))return;const data=await model(),host=q('#content');if(!host)return;const configured=(data.external_forecasters?.configured_count||0)>0,section=document.createElement('section');section.id='forecasterWorkbench';section.className='section panel panel-pad';if(!configured){section.innerHTML=`<div class="section-head"><div><div class="eyebrow">FORECASTER CONSENSUS & DISAGREEMENT</div><h2>External ratings unavailable, by design</h2><p>The comparison schema is active, but no licensed automated Cook, Inside Elections, Crystal Ball, Silver Bulletin or DDHQ feed is configured. MIDTERM SIGNALS does not infer or copy proprietary ratings.</p></div></div><div class="source-list">${(data.external_forecasters?.sources||[]).map(s=>`<div class="source-item"><strong>${esc(s.name)}</strong><div><small>${esc(s.note||'No permitted feed configured.')}</small></div><span class="source-state unavailable">UNAVAILABLE</span></div>`).join('')}</div><p class="data-note">The MIDTERM SIGNALS probabilities remain independent; absence of external data does not push them toward conventional wisdom.</p>`}else{const rows=(data.races||[]).filter(r=>externalEntries(r).length).sort((a,b)=>{const rank={major:0,mild:1,consensus:2};return (rank[disagreement(a)]??3)-(rank[disagreement(b)]??3)||uncertainty(a)-uncertainty(b)});section.innerHTML=`<div class="eyebrow">FORECASTER CONSENSUS & DISAGREEMENT</div><h2>${rows.length} comparable races</h2><div class="forecaster-rows">${rows.map(r=>`<div class="forecaster-row"><button class="text-link" data-v1-race="${esc(r.race_code)}">${esc(r.race_code)}</button><strong>${pct(winp(r))} ${winner(r)}</strong><span>${esc(r.rating)}</span><span>${esc(explorerExternal(r))}</span><b>${esc((disagreement(r)||'unclassified').toUpperCase())}</b></div>`).join('')}</div>`}host.append(section);section.addEventListener('click',e=>{const b=e.target.closest('[data-v1-race]');if(b)navigateRace(b.dataset.v1Race)});
}

/* -------------------------- SOURCE HEALTH ----------------------------- */
async function enhanceData(){
  if(routeView()!=='data'||q('#sourceHealthSummary'))return;const data=await model(),sources=data.source_health||[];const counts={current:0,stale:0,unavailable:0,other:0};for(const s of sources){const k=s.state||'other';counts[k]=(counts[k]||0)+1}const host=q('#content'),box=document.createElement('section');box.id='sourceHealthSummary';box.className='section source-health-summary';box.innerHTML=`<article><strong>${counts.current||0}</strong><span>current</span></article><article><strong>${counts.stale||0}</strong><span>stale</span></article><article><strong>${counts.unavailable||0}</strong><span>unavailable</span></article><article><strong>${sources.length}</strong><span>adapters tracked</span></article><a class="download-card" href="/data/run-report.json"><strong>Run report</strong><span>Build checks, warnings and input commit</span></a>`;const first=host?.querySelector('.panel');first?.before(box);
}

/* ---------------------------- BUILDER --------------------------------- */
function enhanceBuilder(){const root=q('#assignments');if(!root||root.dataset.v1Restored)return;root.dataset.v1Restored='true';const encoded=new URLSearchParams(location.search).get('map');if(!encoded)return;try{const assignments=JSON.parse(atob(encoded));queueMicrotask(()=>{for(const [code,choice] of Object.entries(assignments)){const tile=qa('.assignment',root).find(x=>x.dataset.code===code);tile?.querySelector(`button[data-choice="${choice}"]`)?.click()}})}catch(err){console.warn('Invalid shared election map',err)}}

/* ------------------------ DOCUMENT / CHROME --------------------------- */
async function enhanceTitle(){const view=routeView();if(['home','detail'].includes(view))return;const names={forecast:'Forecast Centre',house:'House Centre',senate:'Senate Centre',races:'Race Explorer',map:'Election Map',polls:'Polling Centre',environment:'National Environment',candidates:'Candidates',money:'Campaign Money',signals:'Campaign Signals',scenarios:'Scenario Lab',builder:'Build Your Own Election',history:'Forecast History',data:'Data & Provenance',methodology:'Methodology',about:'About'};if(names[view])document.title=`${names[view]} · MIDTERM SIGNALS 2026`}
function enhanceKeyboard(){if(document.body.dataset.v1Keys)return;document.body.dataset.v1Keys='true';document.addEventListener('keydown',e=>{if(e.key==='Escape'&&q('#primaryNav')?.classList.contains('open')){q('#primaryNav').classList.remove('open');q('#navToggle')?.setAttribute('aria-expanded','false');q('#navToggle')?.focus()}})}

let scheduled=false;
async function enhance(){if(scheduled)return;scheduled=true;requestAnimationFrame(async()=>{scheduled=false;try{await Promise.allSettled([enhanceMap(),enhanceExplorer(),enhancePolling(),enhancePollster(),enhanceHistory(),enhanceRaceHistory(),enhanceScenario(),enhanceForecasters(),enhanceData(),enhanceTitle()]);enhanceBuilder();enhanceKeyboard()}catch(err){console.warn('v1 enhancement',err)}})}
new MutationObserver(enhance).observe(document.body,{childList:true,subtree:true});
enhance();
