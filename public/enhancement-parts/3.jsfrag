/* ---------------------------- POLLING --------------------------------- */
function allPolls(data){const out=[];for(const p of (data.polls||data.national_environment?.recent_polls||[]))out.push({...p,scope:'National',race_type:'national'});for(const r of data.races||[])for(const p of r.polls||[])out.push({...p,scope:r.race_code,race_type:r.race_type});const seen=new Set();return out.filter(p=>{const k=[p.scope,p.pollster,p.start_date,p.end_date,p.dem,p.rep,p.sponsor].join('|');if(seen.has(k))return false;seen.add(k);return true}).sort((a,b)=>String(b.end_date||'').localeCompare(String(a.end_date||'')))}
function pollCard(p){const src=safeUrl(p.source),sponsor=p.sponsor?`${p.sponsor}${p.sponsor_lean?` · ${p.sponsor_lean}-lean`:''}`:'No sponsor recorded';return `<article class="poll-card"><div><button class="text-link pollster-link" type="button" data-v1-pollster="${esc(p.pollster)}"><strong>${esc(p.pollster||'Unknown pollster')}</strong></button><small>${esc(p.scope||'National')} · ${esc(p.start_date||'—')}–${esc(p.end_date||'—')}</small></div><div><b>${esc(signed(p.margin))}</b><small>D ${p.dem??'—'} · R ${p.rep??'—'}</small></div><div><b>${p.n?Number(p.n).toLocaleString():'—'}</b><small>${esc(p.population||'sample unspecified')} · ${esc(p.mode||'mode unspecified')}</small></div><div><small>${esc(sponsor)}</small>${src?`<a href="${esc(src)}" target="_blank" rel="noopener noreferrer">Source ↗</a>`:''}</div></article>`}
async function enhancePolling(){
  if(routeView()!=='polls'||q('#pollDatabase'))return;const data=await model(),polls=allPolls(data);const host=q('#content');if(!host)return;
  const pollsters=[...new Set(polls.map(p=>p.pollster).filter(Boolean))].sort();
  const section=document.createElement('section');section.id='pollDatabase';section.className='section panel panel-pad';section.innerHTML=`<div class="section-head"><div><div class="eyebrow">POLL DATABASE</div><h2>${polls.length} current-window observations</h2><p>Search raw national and race polls without changing the official aggregate or forecast.</p></div></div><div class="poll-db-controls"><input id="pollDbQ" type="search" placeholder="Pollster, race or sponsor" aria-label="Search poll database"><select id="pollDbScope" aria-label="Poll scope"><option value="all">National + House + Senate</option><option value="national">National generic ballot</option><option value="house">House races</option><option value="senate">Senate races</option></select><select id="pollDbPollster" aria-label="Pollster"><option value="all">All pollsters</option>${pollsters.map(x=>`<option value="${esc(x)}">${esc(x)}</option>`).join('')}</select><select id="pollDbSponsor" aria-label="Sponsorship"><option value="all">Any sponsorship</option><option value="nonpartisan">No partisan lean recorded</option><option value="partisan">Partisan sponsor recorded</option></select></div><div id="pollDbSummary" class="filter-summary"></div><div id="pollDbRows" class="poll-cards"></div>`;host.append(section);
  const render=()=>{const text=q('#pollDbQ').value.trim().toLowerCase(),scope=q('#pollDbScope').value,pollster=q('#pollDbPollster').value,sponsor=q('#pollDbSponsor').value;const rows=polls.filter(p=>{if(scope!=='all'&&p.race_type!==scope)return false;if(pollster!=='all'&&p.pollster!==pollster)return false;if(sponsor==='partisan'&&!p.sponsor_lean)return false;if(sponsor==='nonpartisan'&&p.sponsor_lean)return false;if(text&&!`${p.pollster} ${p.scope} ${p.sponsor||''}`.toLowerCase().includes(text))return false;return true});q('#pollDbSummary').textContent=`${rows.length} of ${polls.length} observations shown.`;q('#pollDbRows').innerHTML=rows.length?rows.slice(0,180).map(pollCard).join(''):'<div class="empty-state">No poll observations match these filters.</div>'};
  qa('#pollDatabase input,#pollDatabase select').forEach(x=>x.addEventListener(x.tagName==='INPUT'?'input':'change',render));section.addEventListener('click',e=>{const b=e.target.closest('[data-v1-pollster]');if(b)location.href=`/?pollster=${encodeURIComponent(b.dataset.v1Pollster)}`});render();
}
async function enhancePollster(){
  const isPollster=location.pathname.startsWith('/pollsters/')||new URLSearchParams(location.search).has('pollster');if(!isPollster||q('#pollsterAllRecords'))return;const data=await model(),label=q('.page-head h1')?.textContent?.trim();if(!label)return;const rows=allPolls(data).filter(p=>String(p.pollster||'').toLowerCase()===label.toLowerCase());const host=q('#content');if(!host)return;const section=document.createElement('section');section.id='pollsterAllRecords';section.className='section panel panel-pad';section.innerHTML=`<div class="eyebrow">ALL CURRENT-CYCLE RECORDS</div><h2>${rows.length} observations across national and race polling</h2>${rows.length?`<div class="poll-cards">${rows.map(pollCard).join('')}</div>`:'<div class="empty-state">No current-cycle records are present for this pollster.</div>'}`;host.append(section);
}

