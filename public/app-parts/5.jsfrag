function methodTechnical(m){return `<h2>Technical architecture</h2><p><b>Partisan baseline:</b> ${esc(m.partisan_lean||'See source code.')}</p><p><b>National environment:</b> ${esc(m.national_environment||'See source code.')}</p><p><b>Incumbency:</b> ${esc(m.incumbency||'See source code.')}</p><p><b>Race polling:</b> ${esc(m.race_polling||'See source code.')}</p><p><b>Race probability:</b> ${esc(m.race_probability||'Normal-error conversion from forecast margin, with uncertainty reduced only by qualifying poll evidence within documented bounds.')}</p><p><b>Chamber simulation:</b> ${esc(m.probabilities||'Correlated Monte Carlo simulation.')}</p><p><b>Senate control:</b> ${esc(m.senate_control||'51 Democratic seats required under the current vice-presidential tie-break assumption.')}</p><div class="callout warning"><b>Prospective integrity:</b> model parameters are not retuned merely because the output looks surprising or differs from external forecasters.</div><p><a href="https://github.com/MusicOfScience/midterm-signals/blob/main/scripts/build_forecast.py">Read the production model source ↗</a></p>`}
function modelHealth(){return `<h2>Historical validation status</h2><div class="callout warning"><b>2018 and 2022 Brier score / log loss: unavailable.</b> The repository does not yet contain rigorous leakage-free historical replays for those cycles. MIDTERM SIGNALS will not manufacture backtest metrics from data that may include future information.</div><p>The v1.0 infrastructure reserves Brier score, log loss, calibration, seat-count error and interval coverage. These fields remain explicitly unavailable until retrospective reconstruction can pin historically available inputs and model versions at each replay date.</p><h2>Current production sanity checks</h2><p>The pipeline validates race universes, probability bounds, seat totals, dates, duplicate identifiers, provenance fields, source staleness and large unexplained forecast jumps before publication.</p>`}
function electionGuide(){const items=[['What is a midterm?','A federal election held halfway through a president’s four-year term.'],['Why every House seat?','US House members serve two-year terms, so all 435 voting seats are contested every two years.'],['Why only part of the Senate?','Senators serve six-year terms in staggered classes; roughly one-third face election every two years, plus any special elections.'],['Generic ballot','A national polling question asking which party a voter prefers for Congress, without naming local candidates.'],['Toss-up','A categorical shorthand for a race with no clear favourite. MIDTERM SIGNALS still shows the underlying probability.'],['70% probability','Not 70% of the vote: about seven wins in ten simulated worlds under the model assumptions.'],['Polling error','The difference between a poll estimate and the underlying electorate; some errors are shared across many races.'],['Tipping-point race','The race near the chamber-control threshold in the model’s ordering.'],['House effect','A systematic tendency for a pollster’s results to lean relative to the broader polling pool, estimated only when data support it.'],['Likely vs registered voter','Different poll populations: likely-voter screens estimate turnout; registered-voter polls include all registered respondents.'],['Why models disagree','Different priors, poll rules, uncertainty assumptions, data coverage and simulation structures can produce different forecasts.']];return `<h2>Election guide</h2><div class="glossary">${items.map(([a,b])=>`<article><h3>${esc(a)}</h3><p>${esc(b)}</p></article>`).join('')}</div>`}

function renderAbout(){$('#content').innerHTML=`${pageHead('ABOUT','What MIDTERM SIGNALS is for','A nonpartisan, open election-analysis system for the 2026 US midterms: fast enough for a casual visitor, inspectable enough for a researcher.')}
  <section class="split"><article class="panel panel-pad prose"><h2>Editorial contract</h2><p>Facts, polls, poll aggregates, model estimates, third-party forecasts, qualitative signals, scenarios and actual results are separate layers. Missing observations are never replaced with zero. Stale last-known-good values are marked stale. Qualitative text does not silently change numerical probabilities.</p></article><article class="panel panel-pad prose"><h2>Privacy</h2><p>The public application requires no account. It does not need personal information to explore races or scenarios. Any future analytics should remain privacy-respecting and compatible with Cloudflare’s minimal analytics model.</p></article></section>
  <section class="section panel panel-pad"><div class="eyebrow">ELECTION NIGHT / RESULTS MODE</div><h2>Architected, not faked.</h2><p class="prose">The results schema distinguishes <b>FORECAST</b>, <b>PROJECTED/CALLED</b> and <b>ACTUAL/OFFICIAL</b>. No live results are displayed until an authoritative or licensed results adapter is configured. The final pre-election forecast will be preserved permanently before results ingest begins.</p></section>`}

function renderPollster(id){const name=decodeURIComponent(String(id||''));const polls=(MODEL.polls||MODEL.national_environment?.recent_polls||[]).filter(p=>slugify(p.pollster)===slugify(name));const label=polls[0]?.pollster||name;$('#content').innerHTML=`${pageHead('POLLSTER',label,'Observable current-cycle records in MIDTERM SIGNALS. Historical performance metrics appear only when defensible leakage-safe data exist.',metaRow('Current records',String(polls.length))+metaRow('House effect','Unavailable')+metaRow('Historical grade','Not invented'))}<section class="panel panel-pad">${renderPollRows(polls)}</section><section class="section panel panel-pad"><div class="eyebrow">METHOD NOTE</div><h2>No borrowed pollster grade</h2><p class="prose">MIDTERM SIGNALS does not assign a grade merely because another organisation publishes one. Any future house-effect or performance estimate must be calculated from a documented dataset and methodology.</p></section>`}

function renderRoute(route){if(!MODEL)return;activeNav(route.view);document.title='MIDTERM SIGNALS · 2026 US Midterm Forecast';switch(route.view){case'home':renderHome();break;case'forecast':renderForecast();break;case'house':renderChamber('house');break;case'senate':renderChamber('senate');break;case'races':renderRaces();break;case'map':renderMap();break;case'polls':renderPolls();break;case'environment':renderEnvironment();break;case'candidates':renderCandidates();break;case'candidate':renderCandidate(route.id);break;case'race':renderRace(route.id);break;case'pollster':renderPollster(route.id);break;case'money':renderMoneyCentre();break;case'signals':renderSignalsPage();break;case'scenarios':renderScenarios();break;case'builder':renderBuilder();break;case'history':renderHistory();break;case'data':renderData();break;case'methodology':renderMethodology();break;case'about':renderAbout();break;default:renderHome()}wireDynamic()}
function wireDynamic(){$$('[data-open-race]').forEach(x=>{const fn=()=>navigate({view:'race',id:x.dataset.openRace});x.addEventListener('click',fn);x.addEventListener('keydown',e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();fn()}})});$$('[data-open-candidate]').forEach(x=>x.addEventListener('click',()=>{if(x.dataset.openCandidate)navigate({view:'candidate',id:x.dataset.openCandidate})}));$$('[data-route-url]').forEach(x=>x.addEventListener('click',e=>{e.preventDefault();history.pushState(null,'',x.dataset.routeUrl);renderRoute(routeFromLocation())}));$$('[data-route="builder"]').forEach(x=>x.addEventListener('click',e=>{e.preventDefault();navigate({view:'builder'})}))}

function setupSearch(){const dialog=$('#searchDialog'),input=$('#globalSearch'),results=$('#searchResults');const open=()=>{dialog.showModal();setTimeout(()=>input.focus(),20)};$('#openSearch').addEventListener('click',open);document.addEventListener('keydown',e=>{if(e.key==='/'&&!['INPUT','TEXTAREA'].includes(document.activeElement.tagName)){e.preventDefault();open()}if(e.key==='Escape'&&dialog.open)dialog.close()});input.addEventListener('input',()=>{const q=input.value;const hits=SEARCH.map(r=>[r,scoreSearch(r,q)]).filter(([,s])=>s>0).sort((a,b)=>b[1]-a[1]).slice(0,12).map(([r])=>r);results.innerHTML=hits.length?hits.map((r,i)=>`<button type="button" class="search-result" role="option" data-search-type="${esc(r.type)}" data-search-key="${esc(r.key)}"><span class="type">${esc(r.type.toUpperCase())}</span><span><b>${esc(r.label)}</b><small>${esc(r.subtitle||'')}</small></span></button>`).join(''):`<p class="muted">No matching race, candidate, pollster or forecaster.</p>`;$$('.search-result',results).forEach(b=>b.addEventListener('click',()=>{dialog.close();const type=b.dataset.searchType,key=b.dataset.searchKey;if(type==='race')navigate({view:'race',id:key});else if(type==='candidate')navigate({view:'candidate',id:key});else if(type==='pollster')navigate({view:'pollster',id:key});else if(type==='forecaster')navigate({view:'forecast'})}))})}
function setupChrome(){const source=MODEL.source_health||SOURCES?.sources||[];const bad=source.filter(s=>['stale','unavailable','degraded','restricted'].includes(s.state||s.health));const chip=$('#healthChip');chip.classList.add(bad.length?'degraded':'current');chip.querySelector('span:last-child').textContent=bad.length?`${bad.length} source issue${bad.length===1?'':'s'}`:'Data current';chip.addEventListener('click',()=>navigate({view:'data'}));$('#contextBar').innerHTML=`<span><strong>${esc(MODEL.model)}</strong> · forecast ${dateFmt(MODEL.generated_at)} · generic ballot ${signed(MODEL.national_environment?.generic_ballot_d_minus_r)} · ${MODEL.races.length} federal legislative races modelled</span>`;$('#navToggle').addEventListener('click',()=>{const n=$('#primaryNav'),open=n.classList.toggle('open');$('#navToggle').setAttribute('aria-expanded',String(open))})}

async function loadJSON(url,fallback=null){try{const r=await fetch(url,{cache:'no-store'});if(!r.ok)throw new Error(`${r.status}`);return await r.json()}catch(e){console.warn(url,e);return fallback}}
async function boot(){
  [MODEL,STATUS,SOURCES]=await Promise.all([loadJSON('/data/forecast.json'),loadJSON('/data/status.json',{}),loadJSON('/data/source-status.json',null)]);
  if(!MODEL){$('#content').innerHTML=`<div class="error-state"><h2>Forecast data unavailable</h2><p>The application shell loaded, but the production forecast snapshot could not be read. The last healthy deployment has not been replaced with fabricated numbers.</p></div>`;return}
  SEARCH=searchRecords(MODEL);setupChrome();setupSearch();renderRoute(routeFromLocation());
}
boot();
