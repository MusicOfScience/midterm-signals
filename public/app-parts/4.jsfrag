  <div class="scenario-banner">EXPLORATORY MAP · NOT OFFICIAL FORECAST</div><div class="preset-row"><button id="modelFav" class="button secondary">START FROM MODEL FAVOURITES</button><button id="tossOpen" class="button secondary">TOSS-UPS UNASSIGNED</button><button id="buildReset" class="button secondary">RESET</button><button id="buildShare" class="button">SHARE THIS MAP</button></div><div id="assignments" class="assignment-grid">${races.map(r=>assignmentTile(r,assignments)).join('')}</div><div id="scoreStrip" class="score-strip"></div>`;const refresh=()=>{const s=buildElectionSummary(assignments,MODEL.races,MODEL.summary);$('#scoreStrip').innerHTML=`<div><strong>${s.houseDem} D / ${s.houseRep} R</strong><small>House · ${s.houseUnassigned} open · control ${s.houseControl}</small></div><div><strong>${s.senateDem} D / ${s.senateRep} R</strong><small>Senate · ${s.senateUnassigned} open · control ${s.senateControl}</small></div><div><strong>${Object.keys(assignments).length}</strong><small>races assigned</small></div><div><strong>Exploratory</strong><small>official forecast unchanged</small></div>`;$$('.assignment').forEach(tile=>{const code=tile.dataset.code;$$('button',tile).forEach(b=>b.classList.toggle('selected',assignments[code]===b.dataset.choice))})};document.addEventListener('click',builderClick,{once:false});function builderClick(e){const b=e.target.closest('.assignment button');if(!b||!$('#assignments')?.contains(b))return;assignments[b.closest('.assignment').dataset.code]=b.dataset.choice;refresh()}$('#modelFav').addEventListener('click',()=>{for(const r of MODEL.races)assignments[r.race_code]=r.dem_probability>=.5?'D':'R';refresh()});$('#tossOpen').addEventListener('click',()=>{for(const r of MODEL.races){if(r.dem_probability>.45&&r.dem_probability<.55)delete assignments[r.race_code];else assignments[r.race_code]=r.dem_probability>=.5?'D':'R'}refresh()});$('#buildReset').addEventListener('click',()=>{for(const k of Object.keys(assignments))delete assignments[k];refresh()});$('#buildShare').addEventListener('click',async()=>{const encoded=btoa(JSON.stringify(assignments));const u=new URL(location.href);u.searchParams.set('view','builder');u.searchParams.set('map',encoded);await navigator.clipboard?.writeText(u.toString());$('#buildShare').textContent='LINK COPIED'});refresh()}
function assignmentTile(r,a){return `<div class="assignment" data-code="${esc(r.race_code)}"><strong>${esc(r.race_code)}</strong><small>${pct(r.dem_probability)} D baseline</small><div class="choice"><button class="d ${a[r.race_code]==='D'?'selected':''}" data-choice="D">D</button><button class="r ${a[r.race_code]==='R'?'selected':''}" data-choice="R">R</button></div></div>`}

async function loadHistorySnapshots(){if(MODEL.history_summaries?.length)return MODEL.history_summaries;if(!HISTORY_INDEX){try{HISTORY_INDEX=await fetch('/data/history/index.json',{cache:'no-store'}).then(r=>r.ok?r.json():Promise.reject(r.status))}catch{return []}}const files=(HISTORY_INDEX.snapshots||[]).slice(0,40);const out=[];for(const f of files){try{const s=await fetch(`/data/history/${f}`,{cache:'no-store'}).then(r=>r.json());out.push({file:f,generated_at:s.generated_at,house:s.summary?.house?.dem_control_probability,senate:s.summary?.senate?.dem_control_probability,gcb:s.national_environment?.generic_ballot_d_minus_r,house_seats:s.summary?.house?.expected_dem_seats,senate_seats:s.summary?.senate?.expected_dem_seats})}catch{}}return out}
async function renderHistory(){$('#content').innerHTML=`${pageHead('FORECAST HISTORY','Snapshots, not rewritten memory','Every production numerical refresh is preserved. Select a date to see what MIDTERM SIGNALS actually said then, not a reconstruction after the fact.')}<section class="panel panel-pad"><p class="muted">Loading immutable snapshots…</p></section>`;const rows=await loadHistorySnapshots();$('#content').innerHTML=`${pageHead('FORECAST HISTORY','Snapshots, not rewritten memory','Every production numerical refresh is preserved. Select a date to see what MIDTERM SIGNALS actually said then, not a reconstruction after the fact.')}
  <section class="panel panel-pad"><div class="section-head"><div><div class="eyebrow">TIMELINE</div><h2>${rows.length} recent snapshots</h2></div></div>${rows.length?`<div class="history-list">${rows.map(x=>`<div class="history-row"><button data-history-file="${esc(x.file||'')}">${dateFmt(x.generated_at)}</button><div><small>House D control</small><br><strong>${pct(x.house)}</strong></div><div><small>Senate D control</small><br><strong>${pct(x.senate)}</strong></div><div><small>House D seats</small><br><strong>${fmt(x.house_seats,1)}</strong></div><div><small>Generic ballot</small><br><strong>${signed(x.gcb)}</strong></div></div>`).join('')}</div>`:empty('No archived production snapshots are indexed.')}</section>
  <section class="section panel panel-pad"><div class="eyebrow">WHAT CHANGED?</div><h2>Input-attributed movement</h2>${renderChanges(MODEL.change_summary||{})}</section>`}

function renderData(){const source=MODEL.source_health||SOURCES?.sources||[];$('#content').innerHTML=`${pageHead('DATA & PROVENANCE','Where every important number came from','Current, stale and unavailable are explicit states. Raw observations, model outputs, external forecasts, campaign signals and actual results remain separate data layers.',metaRow('Input SHA-256',(MODEL.provenance?.input_sha256||'').slice(0,16)||'—')+metaRow('Upstream commit',(MODEL.provenance?.upstream_commit||'').slice(0,12)||'—')+metaRow('Model',MODEL.model))}
  <section class="panel panel-pad"><div class="section-head"><div><div class="eyebrow">SOURCE HEALTH</div><h2>Production adapters</h2></div></div>${renderSources(source)}</section>
  <section class="section"><div class="section-head"><div><div class="eyebrow">DOWNLOADS</div><h2>Public machine-readable data</h2></div></div><div class="download-grid"><a class="download-card" href="/data/forecast.json"><strong>Forecast JSON</strong><span>Complete current production snapshot</span></a><a class="download-card" href="/data/races.csv"><strong>Race forecasts CSV</strong><span>Redistributable derived model outputs</span></a><a class="download-card" href="/data/polls.csv"><strong>Poll observations CSV</strong><span>Public upstream observations where redistribution permits</span></a><a class="download-card" href="/data/source-status.json"><strong>Source status JSON</strong><span>Current / stale / unavailable states</span></a><a class="download-card" href="/data/search.json"><strong>Search index JSON</strong><span>Race, candidate and pollster navigation index</span></a><a class="download-card" href="/data/history/index.json"><strong>Snapshot index</strong><span>Immutable forecast archive</span></a></div></section>
  <section class="section split"><article class="panel panel-pad"><div class="eyebrow">TRANSFORMATION</div><h2>Provenance chain</h2><div class="prose"><p><b>Source:</b> ${esc(MODEL.provenance?.upstream_input_mirror||'Unavailable')}</p><p><b>Retrieved / built:</b> ${dateFmt(MODEL.generated_at)}</p><p><b>Files:</b> ${(MODEL.provenance?.files||[]).map(esc).join(', ')||'Unavailable'}</p><p><b>Transformation:</b> ${esc(MODEL.provenance?.note||'See methodology.')}</p><p><b>Model version:</b> ${esc(MODEL.model)}</p></div></article><article class="panel panel-pad"><div class="eyebrow">LICENSING BOUNDARIES</div><h2>Unavailable beats improper</h2><p class="prose">MIDTERM SIGNALS does not bypass paywalls or invent licensed ratings. Proprietary forecasters remain explicit adapter boundaries until a permitted feed or manual import is configured. Copyrighted prose is not republished.</p></article></section>`}
function renderSources(source){if(!source.length)return empty('No source-status file is present in this snapshot.');return `<div class="source-list">${source.map(s=>`<div class="source-item"><strong>${esc(s.label||s.id)}</strong><div class="source-detail"><small>${esc(s.note||'')}${s.last_success?` · last success ${dateFmt(s.last_success)}`:''}</small>${s.url?`<br><a href="${esc(s.url)}" rel="noopener noreferrer">Source ↗</a>`:''}</div>${sourceState(s)}</div>`).join('')}</div>`}

function renderMethodology(){const m=MODEL.methodology||{};$('#content').innerHTML=`${pageHead('METHODOLOGY','A layered explanation','Read the 30-second overview, the five-minute architecture or the technical assumptions. The model is open to inspection and prospective changes are versioned.')}
  <div class="method-nav"><button class="active" data-method="short">30-second version</button><button data-method="medium">Five-minute version</button><button data-method="technical">Technical version</button><button data-method="health">Model health</button><button data-method="guide">Election guide</button></div><section id="methodBody" class="panel panel-pad prose">${methodShort(m)}</section>`;$$('[data-method]').forEach(b=>b.addEventListener('click',()=>{$$('[data-method]').forEach(x=>x.classList.toggle('active',x===b));const key=b.dataset.method;$('#methodBody').innerHTML=key==='short'?methodShort(m):key==='medium'?methodMedium(m):key==='technical'?methodTechnical(m):key==='health'?modelHealth():electionGuide()}))}
function methodShort(m){return `<h2>What the model broadly does</h2><p>MIDTERM SIGNALS starts with district or state partisan baselines, adds the measured national environment, incumbency and qualifying current race polling, then converts race margins into probabilities. Chamber control comes from correlated Monte Carlo simulations so many races can be wrong in the same direction.</p><div class="callout">News reporting, campaign rhetoric and LLM judgement do not silently alter numerical probabilities.</div>`}
function methodMedium(m){return `<h2>1. Build a structural prior</h2><p>${esc(m.partisan_lean||'Recent presidential results are blended and centred on the national vote to estimate district/state lean.')}</p><h2>2. Add national environment</h2><p>${esc(m.national_environment||'The generic ballot is aggregated with recency, sample-size and source-quality weighting.')}</p><h2>3. Use race polling carefully</h2><p>${esc(m.race_polling||'Qualifying candidate-matched polls are blended with the prior; missing polling remains missing.')}</p><h2>4. Simulate correlated error</h2><p>${esc(m.probabilities||'Race outcomes are simulated with both national and local error terms.')}</p><h2>5. Freeze provenance</h2><p>Each snapshot records an upstream commit, input hash, model version and timestamp. Historical snapshots are not rewritten after later information arrives.</p>`}
