  <section class="section panel panel-pad"><div class="section-head"><div><div class="eyebrow">PROBABILITY HISTORY</div><h2>Forecast through time</h2></div><a href="/?view=history" data-route="history">Full archive →</a></div>${renderRaceHistory(history,r)}</section>
  <section class="section panel panel-pad"><div class="section-head"><div><div class="eyebrow">POLLING</div><h2>Underlying qualifying polls</h2><p>Analytical exclusions here do not modify the official forecast.</p></div></div>${polls.length?renderPollRows(polls):empty(`No qualifying public ${r.race_code} polls are recorded in the current MIDTERM SIGNALS race-poll window. Missing polling remains missing.`)}</section>
  <section class="section split"><article class="panel panel-pad"><div class="eyebrow">EXTERNAL FORECASTERS</div><h2>Native ratings, when licensed</h2>${renderRaceForecasters(ext)}</article><article class="panel panel-pad"><div class="eyebrow">CAMPAIGN MONEY</div><h2>FEC reporting</h2>${r.money?renderMoney(r.money):empty('No current FEC adapter output is attached to this race. Financial figures are not guessed or copied from mismatched reporting periods.')}</article></section>
  <section class="section split"><article class="panel panel-pad"><div class="eyebrow">CAMPAIGN SIGNALS</div><h2>Structured developments</h2>${renderSignals((MODEL.campaign_signals||[]).filter(x=>x.race_code===r.race_code))}</article><article class="panel panel-pad"><div class="eyebrow">SOURCES & PROVENANCE</div><h2>Where this came from</h2><p class="prose">Race metadata and polling are drawn from the production input mirror pinned at commit <code>${esc((MODEL.provenance?.upstream_commit||'').slice(0,12))}</code>. The numerical forecast is computed by MIDTERM SIGNALS using model <code>${esc(MODEL.model)}</code>.</p><a href="/?view=data" data-route="data">Inspect full provenance →</a></article></section>`}
function renderRaceHistory(history,r){if(!history.length)return empty('No multi-snapshot race history is embedded yet. The immutable forecast archive remains available and future v1 snapshots will populate this timeline without rewriting prior forecasts.');const pts=history.slice(-30);const maxW=100;return `<div class="timeline-list">${pts.map(x=>`<div class="timeline"><small>${dayFmt(x.date||x.generated_at)}</small><div class="track"><span style="width:${(x.dem_probability??.5)*maxW}%"></span></div><strong>${pct(x.dem_probability)}</strong></div>`).join('')}</div>`}
function renderRaceForecasters(ext){const names=['Cook Political Report','Inside Elections',"Sabato's Crystal Ball",'Silver Bulletin','Decision Desk HQ'];return `<div class="source-list">${names.map(name=>{const x=ext[name]||{};return `<div class="source-item"><strong>${esc(name)}</strong><div><small>${esc(x.rating||x.note||'No licensed current rating configured.')}</small></div>${sourceState({state:x.rating?'current':'unavailable'})}</div>`}).join('')}</div>`}
function renderMoney(m){return `<div class="facts-grid"><div class="fact"><b>${m.receipts!=null?`$${Number(m.receipts).toLocaleString()}`:'—'}</b><span>receipts</span></div><div class="fact"><b>${m.cash_on_hand!=null?`$${Number(m.cash_on_hand).toLocaleString()}`:'—'}</b><span>cash on hand</span></div><div class="fact"><b>${m.disbursements!=null?`$${Number(m.disbursements).toLocaleString()}`:'—'}</b><span>spending</span></div><div class="fact"><b>${esc(m.coverage_through||'—')}</b><span>reporting through</span></div></div>`}

function renderEnvironment(){const n=MODEL.national_environment||{};const fields=[['Generic ballot',signed(n.generic_ballot_d_minus_r),'Current weighted electoral input'],['Presidential approval',n.presidential_approval?.net!=null?signed(n.presidential_approval.net):'Unavailable','No zero-filling'],['Congressional approval',n.congressional_approval?.net!=null?signed(n.congressional_approval.net):'Unavailable','Descriptive only unless documented'],['Special elections',n.special_elections?.index??'Unavailable','No validated production adapter yet'],['Inflation',n.economy?.inflation??'Unavailable','Economic context'],['Labour market',n.economy?.labour_market??'Unavailable','Economic context'],['Consumer sentiment',n.economy?.consumer_sentiment??'Unavailable','Economic context']];$('#content').innerHTML=`${pageHead('NATIONAL ENVIRONMENT','The political weather, without determinism','National context is separated from race polling. Variables are displayed only when a validated adapter exists; absence is shown explicitly rather than converted to zero.')}
  <section class="thirds">${fields.map(([a,b,c])=>`<article class="panel panel-pad"><div class="eyebrow">${esc(a)}</div><h2>${esc(b)}</h2><p class="muted">${esc(c)}</p></article>`).join('')}</section>
  <section class="section split"><article class="panel panel-pad"><div class="eyebrow">GENERIC BALLOT</div><h2>${signed(n.generic_ballot_d_minus_r)}</h2><p class="prose">The current model uses a 35-day weighted generic congressional ballot aggregate. It is one input among district/state baselines, incumbency and qualifying race polling.</p>${renderPollRows((n.recent_polls||[]).slice(0,8))}</article><article class="panel panel-pad"><div class="eyebrow">HISTORICAL COMPARISON</div><h2>2010 · 2014 · 2018 · 2022</h2>${empty('Comparable same-point historical national-environment series are not yet reconstructed in a leakage-safe production dataset. The interface reserves this comparison without inventing values.')}</article></section>`}

function candidateRaces(name){return MODEL.races.filter(r=>r.dem_candidate===name||r.rep_candidate===name)}
function renderCandidates(){const map=new Map();for(const r of MODEL.races){for(const [party,name] of [['D',r.dem_candidate],['R',r.rep_candidate]])if(name&&!map.has(name))map.set(name,{name,party,race:r})}const list=[...map.values()].sort((a,b)=>Math.abs(a.race.dem_probability-.5)-Math.abs(b.race.dem_probability-.5));$('#content').innerHTML=`${pageHead('CANDIDATES','Candidates in the production race universe','Profiles contain only sourced fields carried by the election dataset or authoritative financial adapters. Missing biography is left missing.')}
  <div class="toolbar"><input id="candidateQ" type="search" placeholder="Search candidate or race"><select id="candidateParty"><option value="all">All parties</option><option value="D">Democratic / aligned</option><option value="R">Republican</option></select><div></div><div></div><div></div></div><div id="candidateList" class="race-table">${renderCandidateList(list)}</div>`;const run=()=>{const q=$('#candidateQ').value.toLowerCase(),party=$('#candidateParty').value;const rows=list.filter(x=>(party==='all'||x.party===party)&&(!q||`${x.name} ${x.race.race_code}`.toLowerCase().includes(q)));$('#candidateList').innerHTML=renderCandidateList(rows)};$('#candidateQ').addEventListener('input',run);$('#candidateParty').addEventListener('change',run)}
function renderCandidateList(list){return list.map(x=>`<div class="race-row" role="button" tabindex="0" data-open-candidate="${esc(x.name)}"><div class="race-code">${esc(x.race.race_code)}</div><div class="candidate-cell"><span class="tag ${x.party.toLowerCase()}">${x.party}</span>${esc(x.name)}</div><div>${esc(stateName(x.race.state))}</div><div>${x.party==='D'?pct(x.race.dem_probability):pct(x.race.rep_probability)}</div><div>${esc(x.race.rating)}</div><div>${x.race.poll_count||0} polls</div><div></div><div></div></div>`).join('')}
function renderCandidate(id){let name=id;const decoded=decodeURIComponent(String(id||''));let races=candidateRaces(decoded);if(!races.length){const candidateNames=[...new Set(MODEL.races.flatMap(r=>[r.dem_candidate,r.rep_candidate]).filter(Boolean))];name=candidateNames.find(n=>slugify(n)===slugify(decoded))||decoded;races=candidateRaces(name)}if(!races.length){$('#content').innerHTML=`${pageHead('CANDIDATE','Candidate not found','No candidate with that identifier is present in the current production race universe.')}`;return}const r=races[0],party=r.dem_candidate===name?'D':'R';$('#content').innerHTML=`${pageHead('CANDIDATE PROFILE',name,`Sourced election profile for ${raceLabel(r)}. No unsourced biography is generated.`,metaRow('Party / alignment',party)+metaRow('Race',r.race_code)+metaRow('Model win probability',pct(party==='D'?r.dem_probability:r.rep_probability)))}
  <section class="split"><article class="panel panel-pad"><div class="eyebrow">RACE</div><h2>${esc(r.race_code)}</h2><p>${esc(r.dem_candidate||'—')} vs ${esc(r.rep_candidate||'—')}</p><button class="button secondary" data-open-race="${esc(r.race_code)}">Open race page</button></article><article class="panel panel-pad"><div class="eyebrow">CAMPAIGN WEBSITE / BIOGRAPHY</div><h2>Source required</h2>${empty('No authoritative candidate biography or campaign-website field is present in the current production input schema. MIDTERM SIGNALS does not fill this gap from memory or generated prose.')}</article></section>
  <section class="section split"><article class="panel panel-pad"><div class="eyebrow">MONEY</div><h2>FEC committee data</h2>${r.money?renderMoney(r.money):empty('FEC adapter not configured for this candidate in the current production snapshot.')}</article><article class="panel panel-pad"><div class="eyebrow">RELATED POLLING</div><h2>${r.poll_count||0} qualifying race polls</h2>${(r.polls||[]).length?renderPollRows(r.polls.slice(0,6)):empty('No qualifying race polls are attached.')}</article></section>`}

function renderMoneyCentre(){const configured=MODEL.money?.state==='current';$('#content').innerHTML=`${pageHead('MONEY / FEC','Campaign money, with reporting periods intact','Financial data are shown only from authoritative FEC-compatible records and only with coverage dates. Mismatched reporting periods are not silently compared.')}
  <section class="panel panel-pad"><div class="section-head"><div><div class="eyebrow">FEC ADAPTER</div><h2>${configured?'Current production feed':'Not configured'}</h2></div>${sourceState({state:configured?'current':'unavailable'})}</div>${configured?renderMoneyTable(MODEL.money.records||[]):empty('The v1 adapter boundary is implemented, but no current FEC API credential/feed is configured in the production pipeline. This does not block the election forecast.')}</section>
  <section class="section panel panel-pad"><div class="eyebrow">COMPARABILITY RULE</div><h2>Coverage dates travel with every dollar figure.</h2><p class="prose">MIDTERM SIGNALS will not compare receipts, spending or cash-on-hand figures from mismatched FEC reporting periods without an explicit warning. Outside spending will remain a separate series where available.</p></section>`}
function renderMoneyTable(rows){if(!rows.length)return empty('No financial records in the current production snapshot.');return `<div class="race-table">${rows.map(x=>`<div class="race-row"><div>${esc(x.race_code)}</div><div>${esc(x.candidate)}</div><div>$${Number(x.receipts||0).toLocaleString()}</div><div>$${Number(x.cash_on_hand||0).toLocaleString()}</div><div>${esc(x.coverage_through||'')}</div><div></div><div></div><div></div></div>`).join('')}</div>`}

function renderSignals(signals=MODEL.campaign_signals||[]){if(!signals.length)return empty('No structured campaign-signal records are present. Qualitative news is not being smuggled into the probability model.');return `<div class="signal-list">${signals.map(s=>`<div class="signal-item"><strong>${dayFmt(s.date)}</strong><div><b>${esc(s.category)}</b> · ${esc(s.geography||s.race_code||'National')}<br><small>${esc(s.description)}</small></div><span class="fresh ${s.model_effect&&s.model_effect!=='NONE'?'stale':'current'}">MODEL EFFECT: ${esc(s.model_effect||'NONE')}</span></div>`).join('')}</div>`}
function renderSignalsPage(){const all=MODEL.campaign_signals||[];$('#content').innerHTML=`${pageHead('CAMPAIGN SIGNALS','Election intelligence, structurally separated','A factual, filterable layer for polling, fundraising, candidate events, redistricting, legal changes and campaign resource signals. Default numerical model effect is NONE.')}
  <section class="panel panel-pad"><div class="section-head"><div><div class="eyebrow">STRUCTURED SIGNALS</div><h2>${all.length} records</h2></div></div>${renderSignals(all)}</section>`}

function renderScenarios(){const p=new URLSearchParams(location.search),g=Number(p.get('gcb')||0),h=Number(p.get('houseSwing')||0),s=Number(p.get('senateSwing')||0);const base=MODEL.summary;const result=runScenario(MODEL,{genericBallotShift:g,houseSwing:h,senateSwing:s});$('#content').innerHTML=`${pageHead('SCENARIO LAB','Stress the baseline, never overwrite it','Transparent counterfactuals recompute chamber simulations from the published race margins. Every output is labelled SCENARIO, NOT OFFICIAL FORECAST.')}
  <div class="scenario-banner">SCENARIO, NOT OFFICIAL FORECAST · official baseline remains unchanged</div>
  <section class="section panel panel-pad"><div class="preset-row"><button data-scenario-g="1">POLLS D+1</button><button data-scenario-g="2">D+2</button><button data-scenario-g="3">D+3</button><button data-scenario-g="-1">R+1</button><button data-scenario-g="-2">R+2</button><button data-scenario-g="-3">R+3</button><button data-scenario-g="5">D+5</button><button data-scenario-g="-5">R+5</button></div><div class="scenario-controls"><div class="scenario-control"><label>Generic ballot shift, D−R points</label><input id="scG" type="number" min="-10" max="10" step="0.5" value="${g}"></div><div class="scenario-control"><label>House national swing, D−R points</label><input id="scH" type="number" min="-10" max="10" step="0.5" value="${h}"></div><div class="scenario-control"><label>Senate national swing, D−R points</label><input id="scS" type="number" min="-10" max="10" step="0.5" value="${s}"></div></div><div class="preset-row"><button class="button secondary" id="scenarioReset">RESET TO OFFICIAL FORECAST</button><button class="button" id="scenarioShare">COPY SHARE LINK</button></div></section>
  <section id="scenarioOutput" class="scenario-output">${scenarioOutput(result,base)}</section>
  <section class="section panel panel-pad"><div class="eyebrow">BUILD YOUR OWN ELECTION</div><h2>Assign battlegrounds manually</h2><p class="muted">For explicit race-by-race counterfactuals, use the election builder. It never writes to production data.</p><button class="button secondary" data-route="builder">Open election builder</button></section>`;const rerun=()=>{const params={genericBallotShift:Number($('#scG').value||0),houseSwing:Number($('#scH').value||0),senateSwing:Number($('#scS').value||0)};$('#scenarioOutput').innerHTML=scenarioOutput(runScenario(MODEL,params),base);const q=new URLSearchParams({view:'scenarios',gcb:params.genericBallotShift,houseSwing:params.houseSwing,senateSwing:params.senateSwing});history.replaceState(null,'',`/?${q}`)};$$('[data-scenario-g]').forEach(b=>b.addEventListener('click',()=>{$('#scG').value=b.dataset.scenarioG;rerun()}));$$('#scG,#scH,#scS').forEach(x=>x.addEventListener('input',rerun));$('#scenarioReset').addEventListener('click',()=>navigate({view:'scenarios'}));$('#scenarioShare').addEventListener('click',async()=>{await navigator.clipboard?.writeText(location.href);$('#scenarioShare').textContent='LINK COPIED'})}
function scenarioOutput(x,base){return `<section class="chamber-pair">${partyProbBlock({...x.house,net_change_dem:x.house.expected_dem_seats-base.house.expected_dem_seats},'HOUSE')}${partyProbBlock({...x.senate,net_change_dem:x.senate.expected_dem_seats-base.senate.expected_dem_seats},'SENATE')}</section><div class="joint-grid"><div class="joint-cell"><strong>${pct(x.joint_control.dem_house_dem_senate)}</strong><span>D House + D Senate</span></div><div class="joint-cell"><strong>${pct(x.joint_control.dem_house_rep_senate)}</strong><span>D House + R Senate</span></div><div class="joint-cell"><strong>${pct(x.joint_control.rep_house_dem_senate)}</strong><span>R House + D Senate</span></div><div class="joint-cell"><strong>${pct(x.joint_control.rep_house_rep_senate)}</strong><span>R House + R Senate</span></div></div><p class="scenario-delta">Scenario simulation: ${x.simulations.toLocaleString()} correlated draws. This browser-side exploration does not modify the official forecast.</p>`}

function renderBuilder(){const races=MODEL.races.filter(r=>r.dem_probability>.08&&r.dem_probability<.92).sort((a,b)=>Math.abs(a.dem_probability-.5)-Math.abs(b.dem_probability-.5));const assignments={};for(const r of MODEL.races){if(r.dem_probability>=.55)assignments[r.race_code]='D';else if(r.dem_probability<=.45)assignments[r.race_code]='R'};$('#content').innerHTML=`${pageHead('BUILD YOUR OWN ELECTION','Assign the battlegrounds','Explore combinations manually. This is not a model run and never changes the official forecast.')}
