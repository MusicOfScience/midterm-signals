  <section class="section split"><article class="panel panel-pad"><div class="eyebrow">UNCERTAINTY</div><h2>Intervals</h2><div class="facts-grid"><div class="fact"><b>${intervalText(h,50)}</b><span>House 50%</span></div><div class="fact"><b>${intervalText(h,95)}</b><span>House 95%</span></div><div class="fact"><b>${intervalText(s,50)}</b><span>Senate 50%</span></div><div class="fact"><b>${intervalText(s,95)}</b><span>Senate 95%</span></div></div></article><article class="panel panel-pad"><div class="eyebrow">FORECASTER COMPARISON</div><h2>Native scales preserved</h2>${renderForecasterStatus()}</article></section>
  <section class="section split"><article class="panel panel-pad"><div class="eyebrow">TIPPING POINT</div><h2>${esc(MODEL.tipping_point_house?.[0]?.race_code||'Unavailable')}</h2>${MODEL.tipping_point_house?.slice(0,6).map(raceMini).join('')||empty('No tipping-point calculation available.')}</article><article class="panel panel-pad"><div class="eyebrow">SCENARIO LAB</div><h2>Stress the baseline</h2><p class="muted">Apply transparent national or chamber swings without overwriting the official forecast.</p><a href="/?view=scenarios" data-route="scenarios">Open Scenario Lab →</a></article></section>`;
}
function renderForecasterStatus(){const list=MODEL.external_forecasters?.sources||[{name:'Cook Political Report',state:'unavailable'},{name:'Inside Elections',state:'unavailable'},{name:"Sabato's Crystal Ball",state:'unavailable'},{name:'Silver Bulletin',state:'unavailable'},{name:'Decision Desk HQ',state:'unavailable'}];return `<div class="source-list">${list.map(s=>`<div class="source-item"><strong>${esc(s.name)}</strong><div><small>${esc(s.note||'No licensed automated feed configured.')}</small></div>${sourceState(s)}</div>`).join('')}</div>`}

function renderChamber(type){
  const isH=type==='house', ch=MODEL.summary[type], races=MODEL.races.filter(r=>r.race_type===type), competitive=races.filter(r=>r.dem_probability>=.3&&r.dem_probability<=.7), flips=races.filter(r=>(r.seat_holder==='REP'&&r.dem_probability>.5)||(r.seat_holder==='DEM'&&r.dem_probability<.5));
  const title=isH?'House Centre':'Senate Centre'; const deck=isH?'All 435 districts, the national seat distribution and the battlefield ordered by uncertainty.':'The 2026 Senate battlefield, seats not up this cycle, paths to 51 Democratic seats and candidate-specific contests.';
  $('#content').innerHTML=`${pageHead(type.toUpperCase(),title,deck,metaRow('Expected D seats',fmt(ch.expected_dem_seats,1))+metaRow('Control probability',pct(ch.dem_control_probability))+metaRow('80% interval',intervalText(ch,80)))}
  <section class="chamber-pair"><article class="chamber-card">${partyProbBlock(ch,isH?'HOUSE':'SENATE')}</article><article class="panel">${distributionChart(ch,isH?435:100,isH?'House':'Senate')}</article></section>
  ${!isH?renderSenatePaths(races,ch):''}
  <section class="section thirds"><article class="panel panel-pad"><div class="eyebrow">COMPETITIVE</div><h2>${competitive.length}</h2><p class="muted">Races between 30% and 70% Democratic win probability.</p></article><article class="panel panel-pad"><div class="eyebrow">MODEL-FAVOURED FLIPS</div><h2>${flips.length}</h2><p class="muted">Seats where the current model favourite differs from the recorded seat holder.</p></article><article class="panel panel-pad"><div class="eyebrow">TIPPING POINT</div><h2>${esc((isH?MODEL.tipping_point_house:MODEL.senate_battlegrounds)?.[0]?.race_code||'—')}</h2><p class="muted">Closest control-relevant race in the current ordering.</p></article></section>
  <section class="section"><div class="section-head"><div><div class="eyebrow">BATTLEFIELD</div><h2>${isH?'Accessible race grid':'State race grid'}</h2><p>Colour is secondary: every tile carries race text, probability and a D/R edge symbol.</p></div><a href="/?view=map" data-route="map">Full map/grid →</a></div>${renderRaceGrid(races.filter(r=>r.dem_probability>.08&&r.dem_probability<.92).sort((a,b)=>Math.abs(a.dem_probability-.5)-Math.abs(b.dem_probability-.5)).slice(0,isH?90:40))}</section>
  <section class="section"><div class="section-head"><div><div class="eyebrow">RACE TABLE</div><h2>${isH?'Every district':'Every Senate contest'}</h2></div><a href="/?view=races" data-route="races">Advanced Race Explorer →</a></div>${renderRaceTable(races.sort((a,b)=>Math.abs(a.dem_probability-.5)-Math.abs(b.dem_probability-.5)))}</section>`;
}
function renderSenatePaths(races,ch){const battles=races.filter(r=>r.dem_probability>.15&&r.dem_probability<.85).sort((a,b)=>b.dem_probability-a.dem_probability);const fixed=ch.fixed_not_up_dem_seats??34;const needed=Math.max(0,51-fixed);return `<section class="section panel panel-pad"><div class="section-head"><div><div class="eyebrow">HOW EACH PARTY GETS TO CONTROL</div><h2>Paths to 51 Democratic seats</h2><p>Democrats begin the simulated cycle with ${fixed} seats not up. They need ${needed} wins from the contests represented in the model to reach 51. This is not a claim that all paths are equally likely.</p></div></div><div class="race-list">${battles.slice(0,12).map(raceMini).join('')}</div></section>`}
function renderRaceGrid(rows){return `<div class="race-grid" role="list">${rows.map(r=>{const p=r.dem_probability,side=p>=.5?'D':'R',cls=p>=.45&&p<=.55?'toss':side==='D'?'d-edge':'r-edge';return `<button class="race-tile ${cls}" type="button" data-open-race="${esc(r.race_code)}" role="listitem" aria-label="${esc(r.race_code)}, ${side} edge, ${pct(Math.max(p,1-p))}"><span class="symbol">${esc(r.race_code)} · ${side}</span><small>${pct(Math.max(p,1-p))}<br>${esc(r.rating||'')}</small></button>`}).join('')}</div>`}
function raceRow(r){const side=winSide(r),fresh=r.latest_race_poll?(ageDays(`${r.latest_race_poll}T12:00:00Z`)<=21?'CURRENT':'STALE'):'UNAVAILABLE';return `<div class="race-row" role="button" tabindex="0" data-open-race="${esc(r.race_code)}" aria-label="Open ${esc(r.race_code)}"><div class="race-code">${esc(r.race_code)}</div><div class="candidate-cell"><span class="tag d">D</span>${esc(r.dem_candidate||'—')}<small class="mobile-opponent muted"> vs ${esc(r.rep_candidate||'—')}</small></div><div class="candidate-cell"><span class="tag r">R</span>${esc(r.rep_candidate||'—')}</div><div class="${side==='D'?'lead-d':'lead-r'}"><b>${pct(winProbability(r))}</b><br><small>${side} win</small></div><div>${signed(r.forecast_margin_d_minus_r)}</div><div>${esc(r.rating||'—')}</div><div>${r.poll_count||0}</div><div><span class="fresh ${fresh.toLowerCase()}">${fresh}</span></div></div>`}
function renderRaceTable(rows){return `<div class="race-table"><div class="race-row header"><div>RACE</div><div>DEMOCRAT / ALIGNED</div><div>REPUBLICAN</div><div>WIN PROB.</div><div>MARGIN</div><div>MODEL RATING</div><div>POLLS</div><div>FRESHNESS</div></div>${rows.map(raceRow).join('')}</div>`}

function renderRaces(){
  const p=new URLSearchParams(location.search); const filters={query:p.get('q')||'',chamber:p.get('chamber')||'all',state:p.get('state')||'all',party:p.get('party')||'all',competitiveness:p.get('competitive')||'all',polling:p.get('polling')||'all',minProb:Number(p.get('min')||0),maxProb:Number(p.get('max')||1)};
  const states=[...new Set(MODEL.races.map(r=>r.state))].sort(); let rows=filterRaces(MODEL.races,filters).sort((a,b)=>Math.abs(a.dem_probability-.5)-Math.abs(b.dem_probability-.5));
  $('#content').innerHTML=`${pageHead('RACE EXPLORER','Interrogate the battlefield','Filter House and Senate contests by geography, model probability, incumbent party, polling availability and competitiveness. Filter state is encoded in the URL for sharing.')}
  <div class="toolbar" id="raceToolbar"><input id="raceQ" type="search" value="${esc(filters.query)}" placeholder="Search race or candidate"><select id="raceChamber"><option value="all">House + Senate</option><option value="house">House</option><option value="senate">Senate</option></select><select id="raceState"><option value="all">All states</option>${states.map(s=>`<option value="${s}">${stateName(s)}</option>`).join('')}</select><select id="raceComp"><option value="all">All competitiveness</option><option value="tossup">Toss-ups 45–55</option><option value="competitive">Competitive 30–70</option><option value="uncertain">Most uncertain 40–60</option></select><button id="raceMore" type="button">More filters</button></div>
  <div class="toolbar hidden" id="moreFilters"><select id="raceParty"><option value="all">Any seat holder</option><option value="dem-held">Democratic-held</option><option value="rep-held">Republican-held</option><option value="dem-flip">R-held, D favoured</option><option value="rep-flip">D-held, R favoured</option></select><select id="racePolling"><option value="all">Any polling</option><option value="recent">Has race poll</option><option value="none">No recent race poll</option></select><label>Min D probability <input id="minProb" type="number" min="0" max="100" step="5" value="${filters.minProb*100}"></label><label>Max D probability <input id="maxProb" type="number" min="0" max="100" step="5" value="${filters.maxProb*100}"></label><button id="raceReset" type="button">Reset</button></div>
  <div class="filter-summary" id="filterSummary">${rows.length} of ${MODEL.races.length} races shown.</div><div id="raceResults">${renderRaceTable(rows)}</div>`;
  $('#raceChamber').value=filters.chamber;$('#raceState').value=filters.state;$('#raceComp').value=filters.competitiveness;
  const update=()=>{const f={query:$('#raceQ').value,chamber:$('#raceChamber').value,state:$('#raceState').value,party:$('#raceParty')?.value||'all',competitiveness:$('#raceComp').value,polling:$('#racePolling')?.value||'all',minProb:Number($('#minProb')?.value||0)/100,maxProb:Number($('#maxProb')?.value||100)/100};const r=filterRaces(MODEL.races,f).sort((a,b)=>Math.abs(a.dem_probability-.5)-Math.abs(b.dem_probability-.5));$('#raceResults').innerHTML=renderRaceTable(r);$('#filterSummary').textContent=`${r.length} of ${MODEL.races.length} races shown.`;const q=new URLSearchParams({view:'races'});for(const [k,v] of [['q',f.query],['chamber',f.chamber],['state',f.state],['party',f.party],['competitive',f.competitiveness],['polling',f.polling]])if(v&&v!=='all')q.set(k,v);if(f.minProb>0)q.set('min',f.minProb);if(f.maxProb<1)q.set('max',f.maxProb);history.replaceState(null,'',`/?${q}`)};
  $$('#raceToolbar input,#raceToolbar select,#moreFilters input,#moreFilters select').forEach(el=>el.addEventListener(el.tagName==='INPUT'?'input':'change',update));$('#raceMore').addEventListener('click',()=>$('#moreFilters').classList.toggle('hidden'));$('#raceReset').addEventListener('click',()=>navigate({view:'races'}));
}

function renderMap(){const p=new URLSearchParams(location.search);const chamber=p.get('chamber')||'house',layer=p.get('layer')||'probability';const rows=MODEL.races.filter(r=>r.race_type===chamber).sort((a,b)=>a.state.localeCompare(b.state)||String(a.district||'').localeCompare(String(b.district||''),undefined,{numeric:true}));$('#content').innerHTML=`${pageHead('MAP / RACE GRID','The national battlefield','A colour-redundant race grid is used as the primary national map where redistributable congressional geometry is not configured. Every cell remains readable by text, keyboard and touch.')}
  <div class="toolbar"><select id="mapChamber"><option value="house">House</option><option value="senate">Senate</option></select><select id="mapLayer"><option value="probability">Model probability</option><option value="margin">Expected margin</option><option value="movement">Change since previous</option><option value="rating">Model rating</option></select><div></div><div></div><button id="mapCompetitive">Competitive only</button></div><div class="panel panel-pad"><p class="data-note"><b>Encoding:</b> D/R letters and numeric values carry the same information as the edge rail. Red/blue colour is never the sole signal.</p><div id="mapGrid">${renderRaceGrid(rows)}</div></div>`;$('#mapChamber').value=chamber;$('#mapLayer').value=layer;$('#mapChamber').addEventListener('change',e=>{const q=new URLSearchParams({view:'map',chamber:e.target.value,layer:$('#mapLayer').value});history.replaceState(null,'',`/?${q}`);renderMap()});$('#mapLayer').addEventListener('change',e=>{const q=new URLSearchParams({view:'map',chamber:$('#mapChamber').value,layer:e.target.value});history.replaceState(null,'',`/?${q}`)});$('#mapCompetitive').addEventListener('click',()=>{$('#mapGrid').innerHTML=renderRaceGrid(rows.filter(r=>r.dem_probability>=.2&&r.dem_probability<=.8))})}

function renderPolls(){const nat=MODEL.national_environment||{},polls=MODEL.polls||nat.recent_polls||[];const racePolls=(MODEL.races||[]).reduce((n,r)=>n+(r.poll_count||0),0);$('#content').innerHTML=`${pageHead('POLLING CENTRE','Polls are observations, not forecasts','Raw poll observations sit beside the MIDTERM SIGNALS aggregates. Issue polling is not mixed into electoral averages.',metaRow('Generic ballot',signed(nat.generic_ballot_d_minus_r))+metaRow('National window',`${nat.polls_in_35_day_window??'—'} polls`)+metaRow('Race-poll records',String(racePolls)))}
  <section class="chamber-pair"><article class="chamber-card"><div class="eyebrow">GENERIC CONGRESSIONAL BALLOT</div><h2>${signed(nat.generic_ballot_d_minus_r)}</h2><p class="muted">35-day weighted aggregate. Weighting accounts for recency, sample size, the source quality field present in the upstream dataset and partisan sponsorship. It is not a simple arithmetic average.</p></article><article class="chamber-card"><div class="eyebrow">PRESIDENTIAL APPROVAL</div><h2>${nat.presidential_approval?.net!=null?signed(nat.presidential_approval.net):'Unavailable'}</h2><p class="muted">${nat.presidential_approval?.net!=null?'Descriptive unless the documented model specification explicitly consumes it.':'No validated current presidential-approval adapter is present in the production input bundle. Missing is not zero.'}</p></article></section>
  <section class="section panel panel-pad"><div class="section-head"><div><div class="eyebrow">RAW NATIONAL POLLS</div><h2>Underlying generic-ballot observations</h2></div></div>${renderPollRows(polls)}</section>
  <section class="section split"><article class="panel panel-pad"><div class="eyebrow">HOUSE POLLS</div><h2>Race pages preserve underlying observations</h2><p class="muted">Use Race Explorer → polling availability to find races with current public race polling.</p><a href="/?view=races&chamber=house&polling=recent" data-route-url="/?view=races&chamber=house&polling=recent">Find polled House races →</a></article><article class="panel panel-pad"><div class="eyebrow">SENATE POLLS</div><h2>Candidate-specific where matched</h2><p class="muted">The production adapter rejects mismatched candidate matchups rather than silently treating them as current.</p><a href="/?view=races&chamber=senate&polling=recent" data-route-url="/?view=races&chamber=senate&polling=recent">Find polled Senate races →</a></article></section>`}
function renderPollRows(polls){if(!polls.length)return empty('No qualifying public polls are available in this snapshot. No average has been fabricated.');return `<div class="poll-list">${polls.map(p=>`<div class="poll-row"><div><strong>${esc(p.pollster||'Unknown pollster')}</strong><div class="poll-meta">${esc(p.sponsor||'')} ${p.sponsor_lean?`· partisan sponsor ${esc(p.sponsor_lean)}`:''}</div></div><div><small>${esc(p.start_date||'')} ${p.start_date?'–':''} ${esc(p.end_date||'')}</small></div><div><small>n=${p.n||'—'} · ${esc(p.population||p.sample_type||'sample n/a')}</small></div><div><small>D ${p.dem??'—'} / R ${p.rep??'—'}</small></div><div class="poll-margin ${Number(p.margin)>=0?'lead-d':'lead-r'}">${signed(Number(p.margin))}</div></div>`).join('')}</div>`}

function findRace(id){return MODEL.races.find(r=>r.race_code.toLowerCase()===String(id||'').toLowerCase())}
function renderRace(id){const r=findRace(id);if(!r){$('#content').innerHTML=`${pageHead('RACE','Race not found','The requested race code is not present in the current production universe.')} ${empty('Check the race code or use global search.')}`;return}const side=winSide(r),polls=r.polls||[],history=r.history||[],ext=r.external_forecasters||{};const st=stateName(r.state);document.title=`2026 ${r.race_type==='senate'?`${st} Senate`:`${r.race_code} House`} Election Forecast & Polls · MIDTERM SIGNALS`;$('#content').innerHTML=`
  <section class="race-hero"><div class="race-title"><div class="eyebrow">${r.race_type.toUpperCase()} · ${esc(st)}</div><h1>${esc(r.race_code)}</h1><div class="contest">2026 ${esc(r.race_type==='senate'?`${st} Senate election`:`${st} ${r.district}th congressional district`)}</div></div><div class="prob-block"><span>CURRENT MODEL FAVOURITE · ${side}</span><strong class="${side==='D'?'lead-d':'lead-r'}">${pct(winProbability(r))}</strong><small>${esc(r.rating)} · expected margin ${signed(r.forecast_margin_d_minus_r)}</small></div></section>
  <div class="candidate-matchup"><article class="candidate-card"><div class="eyebrow party-d">DEMOCRATIC / ALIGNED</div><h2>${esc(r.dem_candidate||'No qualifying nominee recorded')}</h2><p>${r.incumbent_party==='DEM'?'Incumbent party · ':''}${r.aligned_independent?'Democratic-aligned independent':''}</p><button class="link-button" data-open-candidate="${esc(r.dem_candidate||'')}">Candidate profile →</button></article><article class="candidate-card"><div class="eyebrow party-r">REPUBLICAN</div><h2>${esc(r.rep_candidate||'No qualifying nominee recorded')}</h2><p>${r.incumbent_party==='REP'?'Incumbent party':''}</p><button class="link-button" data-open-candidate="${esc(r.rep_candidate||'')}">Candidate profile →</button></article></div>
  <section class="section facts-grid"><div class="fact"><b>${pct(r.dem_probability)}</b><span>D win probability</span></div><div class="fact"><b>${signed(r.forecast_margin_d_minus_r)}</b><span>expected two-party margin</span></div><div class="fact"><b>${signed(r.relative_partisan_lean_d_minus_r)}</b><span>partisan baseline vs nation</span></div><div class="fact"><b>${r.poll_count||0}</b><span>qualifying recent race polls</span></div></section>
  <section class="section split"><article class="panel panel-pad"><div class="section-head"><div><div class="eyebrow">FORECAST</div><h2>What the model says</h2></div></div><div class="metric-line"><div class="metric"><b>${pct(r.dem_probability)}</b><small>D win</small></div><div class="metric"><b>${pct(r.rep_probability)}</b><small>R win</small></div><div class="metric"><b>${fmt(r.dem_two_party_vote,1)}%</b><small>expected D 2-party</small></div><div class="metric"><b>${esc(r.rating)}</b><small>model category</small></div></div><p class="data-note">Probability is an uncertainty estimate, not a vote share. The categorical model rating is derived from MIDTERM SIGNALS probability bands.</p></article><article class="panel panel-pad"><div class="eyebrow">FUNDAMENTALS</div><h2>Prior context</h2><div class="facts-grid"><div class="fact"><b>${signed(r.presidential_margin_2024)}</b><span>2024 presidential margin</span></div><div class="fact"><b>${signed(r.prior_margin)}</b><span>pre-race-poll prior</span></div><div class="fact"><b>${esc(r.incumbent_party||'Open / other')}</b><span>incumbent party</span></div><div class="fact"><b>${r.latest_race_poll?dayFmt(r.latest_race_poll):'None'}</b><span>latest qualifying poll</span></div></div></article></section>
