import {pct,signed,fmt,slugify,raceLabel,winSide,winProbability,uncertaintyScore,runScenario,filterRaces,searchRecords,scoreSearch,buildElectionSummary} from '/core.mjs';

let MODEL=null,STATUS=null,SOURCES=null,HISTORY_INDEX=null,SEARCH=[];
const $=(s,r=document)=>r.querySelector(s), $$=(s,r=document)=>[...r.querySelectorAll(s)];
const esc=v=>String(v??'').replace(/[&<>'"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]));
const dateFmt=v=>{if(!v)return 'Unavailable';const d=new Date(v);return Number.isNaN(d.valueOf())?esc(v):d.toLocaleString(undefined,{dateStyle:'medium',timeStyle:'short'})};
const dayFmt=v=>{if(!v)return 'Unavailable';const d=new Date(`${v}T12:00:00Z`);return Number.isNaN(d.valueOf())?esc(v):d.toLocaleDateString(undefined,{dateStyle:'medium'})};
const ageDays=v=>v?Math.floor((Date.now()-new Date(v).valueOf())/86400000):null;
const stateName=code=>({AL:'Alabama',AK:'Alaska',AZ:'Arizona',AR:'Arkansas',CA:'California',CO:'Colorado',CT:'Connecticut',DE:'Delaware',FL:'Florida',GA:'Georgia',HI:'Hawaii',ID:'Idaho',IL:'Illinois',IN:'Indiana',IA:'Iowa',KS:'Kansas',KY:'Kentucky',LA:'Louisiana',ME:'Maine',MD:'Maryland',MA:'Massachusetts',MI:'Michigan',MN:'Minnesota',MS:'Mississippi',MO:'Missouri',MT:'Montana',NE:'Nebraska',NV:'Nevada',NH:'New Hampshire',NJ:'New Jersey',NM:'New Mexico',NY:'New York',NC:'North Carolina',ND:'North Dakota',OH:'Ohio',OK:'Oklahoma',OR:'Oregon',PA:'Pennsylvania',RI:'Rhode Island',SC:'South Carolina',SD:'South Dakota',TN:'Tennessee',TX:'Texas',UT:'Utah',VT:'Vermont',VA:'Virginia',WA:'Washington',WV:'West Virginia',WI:'Wisconsin',WY:'Wyoming',DC:'District of Columbia'})[code]||code;

function routeFromLocation(){
  if(window.__MIDTERM_ROUTE__)return window.__MIDTERM_ROUTE__;
  const path=location.pathname.split('/').filter(Boolean);
  if(path[0]==='races'&&path[1])return {view:'race',id:decodeURIComponent(path[1])};
  if(path[0]==='candidates'&&path[1])return {view:'candidate',id:decodeURIComponent(path[1])};
  if(path[0]==='pollsters'&&path[1])return {view:'pollster',id:decodeURIComponent(path[1])};
  const p=new URLSearchParams(location.search);
  if(p.get('race'))return {view:'race',id:p.get('race')};
  if(p.get('candidate'))return {view:'candidate',id:p.get('candidate')};
  if(p.get('pollster'))return {view:'pollster',id:p.get('pollster')};
  return {view:p.get('view')||'home'};
}
function urlFor(route,extra={}){
  const p=new URLSearchParams(extra);
  if(route.view==='race')return `/?race=${encodeURIComponent(route.id)}`;
  if(route.view==='candidate')return `/?candidate=${encodeURIComponent(route.id)}`;
  if(route.view==='pollster')return `/?pollster=${encodeURIComponent(route.id)}`;
  p.set('view',route.view||'home'); return `/?${p}`;
}
function navigate(route,extra={}){history.pushState(route,'',urlFor(route,extra));renderRoute(route);$('#primaryNav').classList.remove('open');$('#navToggle').setAttribute('aria-expanded','false');$('#content').focus({preventScroll:true});window.scrollTo({top:0,behavior:'auto'})}
window.addEventListener('popstate',()=>renderRoute(routeFromLocation()));
document.addEventListener('click',e=>{const a=e.target.closest('[data-route]');if(!a)return;e.preventDefault();navigate({view:a.dataset.route})});

function activeNav(view){const root=['race','candidate','pollster'].includes(view)?({race:'races',candidate:'candidates',pollster:'polls'}[view]):view;$$('#primaryNav a').forEach(a=>a.toggleAttribute('aria-current',a.dataset.route===root))}
function pageHead(kicker,title,deck,meta=''){return `<header class="page-head"><div><div class="eyebrow">${esc(kicker)}</div><h1>${esc(title)}</h1><p>${deck}</p></div>${meta?`<div class="page-meta">${meta}</div>`:''}</header>`}
function metaRow(label,value){return `<div><span>${esc(label)}</span><b>${esc(value)}</b></div>`}
function partyProbBlock(ch,label){return `<article class="chamber-card"><div class="eyebrow">${label}</div><h2>${label==='HOUSE'?'218 seats for control':'51 Democratic seats for control'}</h2><div class="control-display"><div><small>DEMOCRATIC CONTROL</small><strong class="party-d">${pct(ch.dem_control_probability)}</strong></div><div class="slash">/</div><div><small>REPUBLICAN CONTROL</small><strong class="party-r">${pct(ch.rep_control_probability)}</strong></div></div><div class="seat-track" aria-label="Expected Democratic seat share"><span style="width:${(ch.expected_dem_seats/(label==='HOUSE'?435:100))*100}%"></span></div><div class="metric-line"><div class="metric"><b>${fmt(ch.expected_dem_seats,1)}</b><small>expected D seats</small></div><div class="metric"><b>${ch.median_dem_seats??'—'}</b><small>median D seats</small></div><div class="metric"><b>${(ch.dem_seats_80_interval||[]).join('–')||'—'}</b><small>80% interval</small></div><div class="metric"><b>${signed(ch.net_change_dem??NaN,1)}</b><small>projected net change</small></div></div></article>`}
function raceLink(r,content){return `<button type="button" data-open-race="${esc(r.race_code)}">${content}</button>`}
function raceMini(r){const side=winSide(r),p=winProbability(r);return `<div class="race-mini"><div class="race-code">${esc(r.race_code)}</div><div>${raceLink(r,`<strong>${esc(r.dem_candidate||'No D nominee')} <span class="muted">vs</span> ${esc(r.rep_candidate||'No R nominee')}</strong><small>${esc(r.rating||'Unrated')} · ${signed(r.forecast_margin_d_minus_r)}</small>`)}</div><div class="prob ${side==='D'?'lead-d':'lead-r'}">${pct(p)}<small>${side} WIN</small></div></div>`}
function empty(text){return `<div class="empty-state">${text}</div>`}
function sourceState(s){const state=s?.state||s?.health||'unavailable';return `<span class="source-state ${esc(state)}">${esc(state.toUpperCase())}</span>`}
function intervalText(ch,p=80){return (ch?.[`dem_seats_${p}_interval`]||[]).join('–')||'—'}

function distributionChart(ch,total,label){
  const dist=ch?.distribution||[]; if(!dist.length)return empty(`Seat distribution is unavailable in this snapshot. The next v1 production refresh will populate the full ${label} distribution.`);
  const max=Math.max(...dist.map(d=>d.probability),.001); const threshold=label==='House'?218:51;
  const bars=dist.map(d=>`<span class="bar ${d.seats>=threshold?'threshold':''}" style="height:${Math.max(2,d.probability/max*100)}%" title="${d.seats} D seats: ${pct(d.probability,1)}"></span>`).join('');
  return `<div class="distribution-wrap"><div class="distribution" role="img" aria-label="${label} Democratic seat probability distribution. Expected ${fmt(ch.expected_dem_seats,1)} seats; 80 percent interval ${intervalText(ch,80)}.">${bars}</div><div class="distribution-axis"><span>${dist[0]?.seats??''} D seats</span><span>control threshold ${threshold}</span><span>${dist.at(-1)?.seats??''} D seats</span></div><p class="chart-summary">Expected ${fmt(ch.expected_dem_seats,1)} Democratic seats · median ${ch.median_dem_seats??'—'} · 50% ${intervalText(ch,50)} · 80% ${intervalText(ch,80)} · 95% ${intervalText(ch,95)}.</p></div>`
}
function deltaText(v,unit='pp'){if(!Number.isFinite(v))return 'Unavailable';const sign=v>0?'+':'';return `${sign}${(v*(unit==='pp'?100:1)).toFixed(1)}${unit==='pp'?' pp':''}`}

function renderHome(){
  const h=MODEL.summary.house,s=MODEL.summary.senate,j=MODEL.summary.joint_control||{};
  const changes=MODEL.change_summary||{};
  const read=MODEL.briefing?.thirty_second_read||`The model currently gives Democrats ${pct(h.dem_control_probability)} probability of House control and ${pct(s.dem_control_probability)} probability of Senate control. The generic congressional ballot input is ${signed(MODEL.national_environment?.generic_ballot_d_minus_r)}.`;
  const movers=[...(MODEL.races||[])].sort((a,b)=>Math.abs(b.change?.dem_probability||0)-Math.abs(a.change?.dem_probability||0)).slice(0,6);
  const uncertain=[...(MODEL.races||[])].sort((a,b)=>uncertaintyScore(b)-uncertaintyScore(a)).slice(0,8);
  const source=MODEL.source_health||SOURCES?.sources||[]; const current=source.filter(x=>(x.state||x.health)==='current').length;
  $('#content').innerHTML=`
  <section class="hero"><div class="hero-grid"><div><div class="eyebrow">2026 US MIDTERM ELECTIONS</div><h1>MIDTERM<br>SIGNALS</h1><p class="hero-deck">A public, probabilistic election reference: current forecast, every federal legislative race, polling, scenarios, history and the provenance behind the numbers.</p></div><div class="countdown-block"><strong>${MODEL.days_to_election}</strong><span>DAYS TO 3 NOVEMBER 2026</span></div></div><div class="meta-line"><span>Last forecast <b>${dateFmt(MODEL.generated_at)}</b></span><span>Model <b>${esc(MODEL.model)}</b></span><span>Last data refresh <b>${dateFmt(MODEL.data_refreshed_at||MODEL.generated_at)}</b></span><span>Inputs <b>${esc((MODEL.provenance?.upstream_commit||'').slice(0,10)||'unavailable')}</b></span></div></section>
  <section class="chamber-pair">${partyProbBlock(h,'HOUSE')}${partyProbBlock(s,'SENATE')}</section>
  <section class="section"><div class="section-head"><div><div class="eyebrow">CONGRESS</div><h2>Joint control</h2><p>The four possible chamber-control combinations from the same correlated simulations.</p></div><a href="/?view=forecast" data-route="forecast">Forecast centre →</a></div><div class="joint-grid"><div class="joint-cell"><strong>${pct(j.dem_house_dem_senate)}</strong><span>Democratic House + Democratic Senate</span></div><div class="joint-cell"><strong>${pct(j.dem_house_rep_senate)}</strong><span>Democratic House + Republican Senate</span></div><div class="joint-cell"><strong>${pct(j.rep_house_dem_senate)}</strong><span>Republican House + Democratic Senate</span></div><div class="joint-cell"><strong>${pct(j.rep_house_rep_senate)}</strong><span>Republican House + Republican Senate</span></div></div></section>
  <section class="section panel read-brief"><div><div class="eyebrow">THE 30-SECOND READ</div><h2>State of the race</h2></div><p>${esc(read)}</p></section>
  <section class="section split"><article class="panel panel-pad"><div class="section-head"><div><div class="eyebrow">WHAT CHANGED?</div><h2>Since the previous forecast</h2></div><a href="/?view=history" data-route="history">History →</a></div>${renderChanges(changes)}</article><article class="panel panel-pad"><div class="section-head"><div><div class="eyebrow">DATA HEALTH</div><h2>${current}/${source.length||'—'} sources current</h2></div><a href="/?view=data" data-route="data">Inspect →</a></div>${renderSourceMini(source)}</article></section>
  <section class="section split"><article class="panel panel-pad"><div class="section-head"><div><div class="eyebrow">HOUSE</div><h2>Tipping-point races</h2></div><a href="/?view=house" data-route="house">House centre →</a></div><div class="race-list">${(MODEL.tipping_point_house||[]).slice(0,8).map(raceMini).join('')}</div></article><article class="panel panel-pad"><div class="section-head"><div><div class="eyebrow">SENATE</div><h2>Control battlegrounds</h2></div><a href="/?view=senate" data-route="senate">Senate centre →</a></div><div class="race-list">${(MODEL.senate_battlegrounds||[]).slice(0,8).map(raceMini).join('')}</div></article></section>
  <section class="section split"><article class="panel panel-pad"><div class="section-head"><div><div class="eyebrow">BIGGEST MOVERS</div><h2>Probability movement</h2></div><a href="/?view=races" data-route="races">Race Explorer →</a></div>${movers.some(r=>Math.abs(r.change?.dem_probability||0)>.0001)?movers.map(raceMini).join(''):empty('No material race-probability movement is recorded against the immediately previous snapshot.')}</article><article class="panel panel-pad"><div class="section-head"><div><div class="eyebrow">MOST UNCERTAIN</div><h2>Closest races</h2></div><a href="/?view=map" data-route="map">Race grid →</a></div>${uncertain.map(raceMini).join('')}</article></section>
  <section class="section split"><article class="panel"><div class="section-head panel-pad"><div><div class="eyebrow">HOUSE CONTROL DISTRIBUTION</div><h2>Not a point prediction</h2></div></div>${distributionChart(h,435,'House')}</article><article class="panel"><div class="section-head panel-pad"><div><div class="eyebrow">SENATE CONTROL DISTRIBUTION</div><h2>Paths remain broad</h2></div></div>${distributionChart(s,100,'Senate')}</article></section>
  <section class="section thirds"><article class="panel panel-pad"><div class="eyebrow">NEW POLLS</div><h2>${MODEL.national_environment?.polls_in_35_day_window??'—'} in national window</h2><p class="muted">Generic-ballot polls are visible beside the MIDTERM SIGNALS aggregate; race polls live on individual race pages.</p><a href="/?view=polls" data-route="polls">Open polling centre →</a></article><article class="panel panel-pad"><div class="eyebrow">FORECASTER DISAGREEMENT</div><h2>${MODEL.external_forecasters?.configured_count?`${MODEL.external_forecasters.configured_count} feeds configured`:'External feeds not configured'}</h2><p class="muted">No proprietary rating is inferred or fabricated. Adapter boundaries are visible in Data & provenance.</p><a href="/?view=forecast" data-route="forecast">Comparison status →</a></article><article class="panel panel-pad"><div class="eyebrow">CAMPAIGN SIGNALS</div><h2>${MODEL.campaign_signals?.length||0} structured signals</h2><p class="muted">Qualitative signals are explicitly separated from numerical probabilities unless a documented quantitative adapter consumes them.</p><a href="/?view=signals" data-route="signals">Open signals →</a></article></section>`;
}
function renderChanges(changes){
  const items=[];
  if(Number.isFinite(changes.house_control_probability))items.push(['House control',deltaText(changes.house_control_probability),'Democratic probability']);
  if(Number.isFinite(changes.senate_control_probability))items.push(['Senate control',deltaText(changes.senate_control_probability),'Democratic probability']);
  if(Number.isFinite(changes.generic_ballot_d_minus_r))items.push(['Generic ballot',`${changes.generic_ballot_d_minus_r>=0?'+':''}${changes.generic_ballot_d_minus_r.toFixed(1)} pt`,'D−R aggregate']);
  for(const x of changes.changed_inputs||[])items.push(['Input changed',x,'Observed source file']);
  if(!items.length)return empty('No prior comparable v1 snapshot is available yet. No change has been invented.');
  return `<div class="change-list">${items.slice(0,7).map(([a,b,c])=>`<div class="change-item"><strong>${esc(a)}</strong><div><b>${esc(b)}</b><br><small>${esc(c)}</small></div><span></span></div>`).join('')}</div>`
}
function renderSourceMini(source){if(!source.length)return empty('Source-health report is not present in this snapshot.');return `<div class="source-list">${source.slice(0,6).map(s=>`<div class="source-item"><strong>${esc(s.label||s.id)}</strong><div><small>${esc(s.note||s.kind||'')}</small></div>${sourceState(s)}</div>`).join('')}</div>`}

function renderForecast(){
  const h=MODEL.summary.house,s=MODEL.summary.senate,j=MODEL.summary.joint_control||{};
  const now=MODEL.nowcast||MODEL.summary,eday=MODEL.election_day_forecast||MODEL.summary;
  $('#content').innerHTML=`${pageHead('FORECAST CENTRE','Forecast, uncertainty, paths','The official baseline and its uncertainty are numerical model outputs. The nowcast describes today’s measured environment; the election-day view preserves uncertainty about the final outcome.',metaRow('Model',MODEL.model)+metaRow('Simulations',(h.simulations||'—').toLocaleString?.()||h.simulations)+metaRow('Updated',dateFmt(MODEL.generated_at)))}
  <section class="chamber-pair">${partyProbBlock(h,'HOUSE')}${partyProbBlock(s,'SENATE')}</section>
  <section class="section split"><article class="panel panel-pad"><div class="eyebrow">NOWCAST</div><h2>If today’s measured environment held</h2><p>${esc(MODEL.forecast_notes?.nowcast||'The current model has no separate time-evolution layer; this view therefore uses the same measured environment as the official baseline and is labelled accordingly rather than implying extra precision.')}</p><div class="metric-line"><div class="metric"><b>${pct(now.house?.dem_control_probability??h.dem_control_probability)}</b><small>House D control</small></div><div class="metric"><b>${pct(now.senate?.dem_control_probability??s.dem_control_probability)}</b><small>Senate D control</small></div></div></article><article class="panel panel-pad"><div class="eyebrow">ELECTION-DAY FORECAST</div><h2>3 November 2026</h2><p>${esc(MODEL.forecast_notes?.election_day||'The production baseline represents election-outcome uncertainty under the current model specification. Future political movement is not separately modelled as a deterministic trend.')}</p><div class="metric-line"><div class="metric"><b>${pct(eday.house?.dem_control_probability??h.dem_control_probability)}</b><small>House D control</small></div><div class="metric"><b>${pct(eday.senate?.dem_control_probability??s.dem_control_probability)}</b><small>Senate D control</small></div></div></article></section>
  <section class="section panel panel-pad"><div class="eyebrow">MODEL CONFIDENCE ≠ POLITICAL CERTAINTY</div><h2>Probability describes repeated uncertainty, not vote share.</h2><p class="prose">An 80% probability does not mean an 80% vote share. It means that, under the assumptions represented by the model, outcomes of that class occur about four times in five across simulated election worlds. A 20% outcome is not a contradiction; it is an outcome the model explicitly said could happen.</p></section>
  <section class="section split"><article class="panel"><div class="panel-pad"><div class="eyebrow">HOUSE SEATS</div><h2>Full probability distribution</h2></div>${distributionChart(h,435,'House')}</article><article class="panel"><div class="panel-pad"><div class="eyebrow">SENATE SEATS</div><h2>Full probability distribution</h2></div>${distributionChart(s,100,'Senate')}</article></section>
  <section class="section"><div class="section-head"><div><div class="eyebrow">CONGRESS</div><h2>Control combinations</h2></div></div><div class="joint-grid"><div class="joint-cell"><strong>${pct(j.dem_house_dem_senate)}</strong><span>D House + D Senate</span></div><div class="joint-cell"><strong>${pct(j.dem_house_rep_senate)}</strong><span>D House + R Senate</span></div><div class="joint-cell"><strong>${pct(j.rep_house_dem_senate)}</strong><span>R House + D Senate</span></div><div class="joint-cell"><strong>${pct(j.rep_house_rep_senate)}</strong><span>R House + R Senate</span></div></div></section>
